# mudah-rs membaca variabel yang SAMA dengan Mudah-API (Node). Selama masa
# transisi, satu .env bisa dipakai kedua proses.

# --- Wajib ---
DATABASE_URL=postgres://user:pass@localhost:5432/mudah
SECRET_TOKEN=            # secret JWT, HARUS sama dengan Node
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=

# --- Khusus Rust ---
RS_PORT=3100             # fallback ke PORT, lalu 3100
RS_DB_MAX_CONNECTIONS=20
# GET /projects: maks. request yang memegang koneksi DB bersamaan (bawaan RS_DB_MAX_CONNECTIONS/3)
# RS_PROJECTS_LIST_CONCURRENCY=6
# GET /projects dari desktop (token ber-sid, tanpa Origin) tanpa relasi; 0/false/off = respons lengkap
# RS_PROJECTS_DEVICE_LITE=true
RS_LOG_DIR=logs
MAIL_TEMPLATE_DIR=templates/mail
RUST_LOG=info,sqlx=warn

# --- Sama dengan Node ---
JWTEXPIRED_IN=           # hanya untuk menerbitkan token; verifikasi mengabaikan exp
ROUNDSOFHASHING=10
RATE_LIMIT_MAX=20
FREE_SUBSCRIPTION_DAYS=
FREE_SUBSCRIPTION_GRACE_DAYS=3
MANUAL_SUBSCRIPTION_GRACE_DAYS=7
MAIL_FROM=
MAILTRAP_TOKEN=
MIXPANEL_PROJECT_TOKEN=
MIXPANEL_ENV=development
MIXPANEL_API_HOST=
FRONTEND_URL=
HOST_FE=
HOST_BE=

# --- Khusus Rust (opsional) ---
REDIS_DB=                # indeks DB Redis; kosong = 0 (sama dengan Node)

# --- Uji integrasi (JANGAN taruh di .env yang dimuat proses) ---
# MZ_TEST_DATABASE_URL=postgres://postgres:pw@127.0.0.1:5432/postgres
# MZ_TEST_TEMPLATE=mudah_test_template
# MZ_TEST_REDIS_DB=15
# MZ_TEST_REQUIRE_DB=1   # CI: gagal (bukan SKIP) bila DB test tidak siap

# --- Invalidasi cache lintas proses (Node <-> Rust), lihat plan/cache-invalidation-protocol.md ---
# CACHE_INVALIDATION_CHANNEL=mz:cache-invalidate   # channel Redis Pub/Sub (harus sama di Node & Rust)
# CACHE_INVALIDATION_ENABLED=true                  # "false" mematikan publish + subscribe

# Cron & worker Rust (Fase 4a, crate mz-jobs). MATI bawaan. Aktifkan sebuah job HANYA
# setelah cron yang sama dimatikan di Node, kalau tidak akan jalan dua kali.
# Nilai: `all` atau daftar nama dipisah koma; daftar nama: `mudah-rs job x` mencetaknya.
# MZ_JOBS=
