  companyId       Int
  leaveType       LeaveType?
  leaveTypeId     Int?
  startDate       DateTime           @db.Date
  endDate         DateTime           @db.Date
  startDayType    LeaveDayType       @default(FULL_DAY)
  endDayType      LeaveDayType       @default(FULL_DAY)
  totalDays       Float
  reason          String             @db.Text
  documentKey     String?            @db.VarChar(500)
  status          LeaveStatus        @default(PENDING)
  rejectionReason String?            @db.Text
  revisionNote    String?            @db.Text
  approvalNote    String?            @db.Text
  balanceBefore   Float?
  balanceAfter    Float?
  reviewedById    Int?
  reviewedAt      DateTime?
  approverId      Int?
  createdAt       DateTime           @default(dbgenerated("NOW()"))
  updatedAt       DateTime?          @default(dbgenerated("NOW()"))

