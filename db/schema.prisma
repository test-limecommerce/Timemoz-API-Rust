/// Catatan setiap kali employee melewati batas kerja harian atau mingguan
model workLimitBreach {
  id               Int           @id @default(autoincrement())
  uuid             String        @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId           Int
  companyId        Int
  limitType        WorkLimitType // DAILY atau WEEKLY
  periodDate       DateTime      @db.Date
  // periodDate untuk DAILY = tanggal hari itu
  // periodDate untuk WEEKLY = tanggal Senin minggu tersebut
  breachAt         DateTime
  // Jam persis saat total detik pertama kali melewati limit
  breachTimelineId Int?
  // FK ke trackingTimeline — entry yang menyebabkan breach.
  // Null jika tidak bisa dihitung (data tidak lengkap).
  workedSec        Int // Total detik yang dikerjakan saat breach terdeteksi
  limitSec         Int // Nilai limit yang berlaku saat itu
  overtimeSec      Int // workedSec - limitSec
  createdAt        DateTime      @default(dbgenerated("NOW()"))
  updatedAt        DateTime?     @default(dbgenerated("NOW()"))

  user           users?            @relation(fields: [userId], references: [id], onDelete: Cascade)
  company        company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
