/// Karyawan yang SELALU butuh approval walau company memakai NONE/LIMIT
/// (specs/005-manual-time-approval-settings).
model manualTimeApprovalException {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  userId      Int
  /// null = "Selalu butuh persetujuan" (arti lama; baris legacy tetap begini).
  /// Angka = batas auto-approve khusus karyawan ini dalam menit, memakai periode
  /// `manualTimeAutoApprovePeriod` company. Hanya berlaku di mode LIMIT.
  /// Mengubah aturan = cabut baris lama (deletedAt) + buat baris baru.
  limitMinutes Int?
  /// null = ditambahkan oleh default karyawan baru saat join (tanpa admin pelaku)
  createdById Int?
  /// Soft delete: pencabutan harus tetap terbaca di audit. SETIAP pembacaan WAJIB menyaring `deletedAt: null`.
  deletedAt   DateTime?
  createdAt   DateTime  @default(dbgenerated("NOW()"))

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      users   @relation("ManualTimeApprovalExceptionUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy users?  @relation("ManualTimeApprovalExceptionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  /// `@@unique([companyId, userId])` TIDAK dipakai: ia menutup pintu bagi baris yang sudah dicabut
  /// untuk ditambahkan kembali. Penggantinya partial unique index manual
  /// "manualTimeApprovalException_unique_active" (WHERE "deletedAt" IS NULL).
  @@index([companyId, deletedAt])
  @@index([userId])
}

enum DivisionMemberRole {
  LEADER
  MEMBER
}

/// Divisi karyawan (specs/006-employee-divisions). SETIAP pembacaan WAJIB menyaring
/// `deletedAt: null`. Nama unik per company tanpa membedakan huruf besar/kecil lewat partial
/// index manual "division_company_name_unique_active" (companyId, LOWER(name)) WHERE deletedAt IS NULL.
model division {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  name        String    @db.VarChar(60)
  description String?   @db.VarChar(200)
  /// Naik tiap tulis ke divisi atau anggotanya (cek stale PATCH, research R6).
  version     Int       @default(0)
  createdById Int?
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime  @default(dbgenerated("NOW()"))
  deletedAt   DateTime?

  company   company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users?           @relation("DivisionCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)
  members   divisionMember[]

  @@unique([id, companyId])
  @@index([companyId, deletedAt])
}

/// Keanggotaan divisi (specs/006-employee-divisions). SETIAP pembacaan WAJIB menyaring
/// `deletedAt: null`. Partial unique index manual "divisionMember_division_user_unique_active"
/// (divisionId, userId) WHERE deletedAt IS NULL: maks. satu baris hidup per orang per divisi.
/// Sejak Amendment A1 (migration 20261110100000) satu divisi boleh punya banyak Leader dan satu
/// orang boleh ada (dan memimpin) di banyak divisi; "minimal satu Leader" dijaga di kode.
model divisionMember {
  id          Int                @id @default(autoincrement())
  uuid        String             @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  divisionId  Int
  userId      Int
  role        DivisionMemberRole
  createdById Int?
  createdAt   DateTime           @default(dbgenerated("NOW()"))
  deletedAt   DateTime?

  company   company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  division  division @relation(fields: [divisionId, companyId], references: [id, companyId], onDelete: Cascade)
  user      users    @relation("DivisionMemberUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy users?   @relation("DivisionMemberCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([divisionId, deletedAt])
  @@index([companyId, userId, deletedAt])
}

