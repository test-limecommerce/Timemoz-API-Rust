// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model users {
  id                         Int                         @id @default(autoincrement())
  uuid                       String                      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  username                   String                      @unique @db.VarChar(255)
  password                   String                      @db.VarChar(255)
  name                       String                      @db.VarChar(255)
  createdAt                  DateTime                    @default(dbgenerated("NOW()"))
  updatedAt                  DateTime?                   @default(dbgenerated("NOW()"))
  sentAt                     DateTime?                   @default(dbgenerated("NOW()"))
  status                     Int
  tokensValidAfter           DateTime?
  googleId                   String?                     @unique @db.VarChar(255)
  userAccessLevel            userAccessLevel[]
  userCompany                userCompany[]
  invitedUserCompanies       userCompany[]               @relation("UserCompanyInvitedBy")
  ownedCompanies             company[]                   @relation("CompanyOwner")
  projectUser                projectUser[]
  tracking                   tracking[]
  connected                  userConnected[]
  shareReport                shareReport[]
  shareReportUsers           shareReportUsers[]
  dailyUserProjectSummary    dailyUserProjectSummary[]
  scheduledReports           scheduledReport[]
  userLocalDb                userLocalDb[]
  userLog                    userLog[]
  manualTimeApprovers        projectManualTimeApprover[]
  defaultManualTimeApprovers defaultManualTimeApprover[]
  manualTimeApprovedEntries  trackingTimeline[]          @relation("ManualTimeApprover")
  manualTimeApprovalExceptionsAsUser    manualTimeApprovalException[] @relation("ManualTimeApprovalExceptionUser")
  manualTimeApprovalExceptionsCreated   manualTimeApprovalException[] @relation("ManualTimeApprovalExceptionCreatedBy")
  divisionMembers                       divisionMember[]              @relation("DivisionMemberUser")
  divisionsCreated                      division[]                    @relation("DivisionCreatedBy")
  divisionMembersCreated                divisionMember[]              @relation("DivisionMemberCreatedBy")
  userPayRates               userPayRate[]
  timesheets                 timesheet[]
  timesheetApprovals         timesheet[]                 @relation("TimesheetApprover")
  userWorkTimeLimits         userWorkTimeLimit[]
  timesheetInvoices          timesheetInvoice[]
  workLimitBreaches          workLimitBreach[]
  managerSummaryConfigs      managerSummaryConfig[]
  clickupMappings            userClickupMapping[]
  jiraMappings               userJiraMapping[]
  discordMappings            userDiscordMapping[]
  timesheetApprovalTokens    timesheetApprovalToken[]    @relation("TimesheetApprovalTokenApprover")
  manualTimeApprovalTokens   manualTimeApprovalToken[]   @relation("ManualTimeApprovalTokenApprover")
  mcpTokens                  mcpAccessToken[]
  mcpAccessTokenLogs         mcpAccessTokenLog[]
  mcpOAuthCodes                mcpOAuthCode[]
  mcpOAuthAccessTokens         mcpOAuthAccessToken[]
  mcpOAuthAccessTokenLogs      mcpOAuthAccessTokenLog[]
  mcpOAuthRefreshTokens        mcpOAuthRefreshToken[]
  googleCalendarAccessToken    String?                     @db.Text
  googleCalendarRefreshToken   String?                     @db.Text
  googleCalendarTokenExpiresAt DateTime?
  googleCalendarEmail          String?                     @db.VarChar(255)
  googleCalendarSyncToken      String?                     @db.Text
  googleCalendarEvents         googleCalendarEvent[] @relation("GCalEventUser")
  googleCalendarCreatedEvents  googleCalendarEvent[] @relation("GCalEventCreatedBy")
  mobileShifts                 mobileShift[]
  mobileBreaks                 mobileBreak[]
  geofenceAuditLogs            geofenceAuditLog[]
  createdGeofences             geofence[]
  createdNegativeZones         negativeZone[]
  leaveRequests                leaveRequest[]
  reviewedLeaveRequests        leaveRequest[]        @relation("LeaveReviewer")
  assignedLeaveRequests        leaveRequest[]        @relation("LeaveRequestApprover")
  employeeLeavePolicy          employeeLeavePolicy[]
  leaveBalances                leaveBalance[]
  holidayLeaveDeductions       holidayLeaveDeduction[]
  leaveBalanceAdjustments      leaveBalanceAdjustment[]
  madeLeaveBalanceAdjustments  leaveBalanceAdjustment[] @relation("BalanceAdjustedBy")
  employeeLeaveTier            employeeLeaveTier[]
  kycFace                      userKycFace?
  leavePolicyApprovers         leavePolicyApprover[]
  stores                       store[]
  storeVisits                  storeVisit[]
  storeVisitAuditLogs          storeVisitAuditLog[]
  storeVisitLocationEvents     storeVisitLocationEvent[]
  createdStoreGroups           storeGroup[]          @relation("StoreGroupCreatedBy")
  createdStoreVisitPlans       storeVisitPlan[]      @relation("StoreVisitPlanCreatedBy")
  createdCustomerTypes         customerType[]        @relation("CustomerTypeCreatedBy")
  createdCustomerGroups        customerGroup[]       @relation("CustomerGroupCreatedBy")
  createdCustomerChannels      customerChannel[]     @relation("CustomerChannelCreatedBy")
  createdCustomerSubChannels   customerSubChannel[]  @relation("CustomerSubChannelCreatedBy")
  createdCustomers             customer[]            @relation("CustomerCreatedBy")
  // docs/product_master.md §3 (F1). `productImportJob.createdById` sengaja TIDAK
  // punya relasi — satu-satunya FK modul itu yang begitu (§3 pembuka).
  createdProductCategories     productCategory[]     @relation("ProductCategoryCreatedBy")
  createdProductSubCategories  productSubCategory[]  @relation("ProductSubCategoryCreatedBy")
  createdProductBrands         productBrand[]        @relation("ProductBrandCreatedBy")
  createdProductPrincipals     productPrincipal[]    @relation("ProductPrincipalCreatedBy")
  createdUoms                  uom[]                 @relation("UomCreatedBy")
  createdTaxRates              taxRate[]             @relation("TaxRateCreatedBy")
  createdProductCustomFields   productCustomField[]  @relation("ProductCustomFieldCreatedBy")
  createdProducts              product[]             @relation("ProductCreatedBy")
  createdPriceLists            priceList[]           @relation("PriceListCreatedBy")
  // docs/order_design.md §3 (F1).
  createdOrderCustomFieldDefinitions orderCustomFieldDefinition[] @relation("OrderCustomFieldDefinitionCreatedBy")
  createdOrderTypes            orderType[]           @relation("OrderTypeCreatedBy")
  createdOrderReasons          orderReason[]         @relation("OrderReasonCreatedBy")
  createdOrderPaymentTerms     orderPaymentTerm[]    @relation("OrderPaymentTermCreatedBy")
  createdOrderPaymentMethods   orderPaymentMethod[]  @relation("OrderPaymentMethodCreatedBy")
  // docs/visit_masters.md §3 (F1).
  createdVisitTypes            visitType[]           @relation("VisitTypeCreatedBy")
  createdVisitFrequencies      visitFrequency[]      @relation("VisitFrequencyCreatedBy")
  createdOrders                order[]               @relation("OrderCreatedBy")
  /// §0.10 — pemilik order (yang diperhitungkan), BUKAN pengetik.
  ownedOrders                  order[]               @relation("OrderOwner")
  submittedOrders               order[]               @relation("OrderSubmittedBy")
  approvedOrders                order[]               @relation("OrderApprovedBy")
  rejectedOrders                order[]               @relation("OrderRejectedBy")
  cancelledOrders               order[]               @relation("OrderCancelledBy")
  /// specs/003 — pencatat delivery AWAL (koreksi hanya di orderDelivery.recordedBy).
  deliveredOrders               order[]               @relation("OrderDeliveredBy")
  recordedOrderDeliveries       orderDelivery[]       @relation("OrderDeliveryRecordedBy")
  storeVisitNoOrders            storeVisitNoOrder[]
  // specs/004-overtime-pp35 — lembur per PP 35/2021.
  createdWorkPatterns          companyWorkPattern[]    @relation("CompanyWorkPatternCreatedBy")
  updatedOvertimeSettings      companyOvertimeSetting[] @relation("CompanyOvertimeSettingUpdatedBy")
  overtimeApproverships        overtimeApprover[]      @relation("OvertimeApproverUser")
  createdOvertimeApprovers     overtimeApprover[]      @relation("OvertimeApproverCreatedBy")
  overtimeRequests             overtimeRequest[]       @relation("OvertimeRequestEmployee")
  requestedOvertimeRequests    overtimeRequest[]       @relation("OvertimeRequestRequestedBy")
  decidedOvertimeRequests      overtimeRequest[]       @relation("OvertimeRequestDecidedBy")
  cancelledOvertimeRequests    overtimeRequest[]       @relation("OvertimeRequestCancelledBy")
  productTourStatus            String?               @default("NOT_STARTED") @db.VarChar(20)
  productTourStep              String?               @db.VarChar(64)
  productTourUpdatedAt         DateTime?
  // GA4 client_id stabil per user. Di-generate lazy oleh backend saat event
  // pertama; sengaja nullable + generik supaya bisa ditimpa kalau FE nanti
  // mengirim client_id asli dari cookie _ga.
  gaClientId                   String?               @db.VarChar(64)
  analyticsEvents              analyticsEvent[]
  // Kapan email user terverifikasi: saat klik link konfirmasi, atau saat
  // register via Google (email sudah diverifikasi Google). NULL untuk user
  // lama sebelum kolom ini ada — mereka sengaja tidak ikut email di bawah.
  emailVerifiedAt              DateTime?
  // Email `sales-trial-onboarding`: ditandai saat register paket SALES, lalu
  // dikirim sekali oleh cron 24 jam setelah verifikasi kalau company-nya belum
  // create organization. SentAt terisi = sudah diklaim/terkirim, jangan ulang.
  salesOnboardingEmailEligible Boolean               @default(false)
  salesOnboardingEmailSentAt   DateTime?

  @@index([productTourStatus])
  @@index([salesOnboardingEmailEligible, salesOnboardingEmailSentAt])
}

/// Satu baris = satu lifecycle event GA4 yang sudah diklaim untuk seorang user.
/// Unique (userId, eventName) adalah satu-satunya yang menjamin "maksimal 1x
/// seumur hidup" — jaminannya di level DB, bukan logic aplikasi, supaya bebas
/// dari TOCTOU saat dua pemicu datang bersamaan.
model analyticsEvent {
  id         Int       @id @default(autoincrement())
  uuid       String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId     Int
  eventName  String    @db.VarChar(50)
  status     String    @default("PENDING") @db.VarChar(20) // PENDING | SENDING | SENT | FAILED | SKIPPED
  attempts   Int       @default(0)
  params     Json?
  occurredAt DateTime // kapan milestone-nya benar-benar terjadi
  sendingAt  DateTime? // kapan HTTP ke GA mulai ditembak (deteksi row nyangkut)
  sentAt     DateTime?
  lastError  String?   @db.Text
  createdAt  DateTime  @default(dbgenerated("NOW()"))
  updatedAt  DateTime? @default(dbgenerated("NOW()"))
  user       users?    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([userId, eventName]) // jaminan "1x saja"
  @@index([status, attempts]) // sweeper retry
  @@index([eventName, createdAt])
}

model jwtBlackList {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId    Int
  tokenHash String    @unique @db.VarChar(64)
  revokedAt DateTime  @default(dbgenerated("NOW()"))
  createdAt DateTime  @default(dbgenerated("NOW()"))
  updatedAt DateTime? @default(dbgenerated("NOW()"))
  status    Int

  @@index([userId])
}

model userForgotPassword {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  createdAt DateTime  @default(dbgenerated("NOW()"))
  sentAt    DateTime? @default(dbgenerated("NOW()"))
  expiredAt DateTime? @default(dbgenerated("NOW()"))
  updatedAt DateTime? @default(dbgenerated("NOW()"))
  userId    Int
  status    Int

  @@index([userId])
  @@index([userId, status])
}

/// Role. `companyId IS NULL` = role bawaan sistem (global, `isSystem = true`);
/// `companyId` terisi = role custom milik satu company (`isSystem = false`).
/// Bentuk itu bukan konvensi — ia ditegakkan CHECK `accessLevel_shape_chk`
/// (docs/custom_roles.md §3.5), yang hanya hidup di migration SQL dan di
/// prisma/apply-partial-indexes.js karena schema.prisma tidak bisa menyatakannya.
model accessLevel {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  code            String            @db.VarChar(255)
  name            String            @db.VarChar(255)
  createdAt       DateTime          @default(dbgenerated("NOW()"))
  updatedAt       DateTime?         @default(dbgenerated("NOW()"))
  status          Int

  // ── Custom roles (docs/custom_roles.md §3.1) — semuanya nullable / ber-default,
  //    jadi aman dipasang pada database yang sedang melayani trafik.
  /// NULL = role bawaan sistem (global). Terisi = milik satu company.
  companyId       Int?
  /// Role bawaan: tidak bisa diedit, dinonaktifkan (CHECK), maupun dihapus (trigger).
  isSystem        Boolean           @default(false)
  /// Plafon (§0.10) — NULL untuk role bawaan, WAJIB untuk role custom. BUKAN pewarisan
  /// permission: matriks `rolePermission` tetap satu-satunya yang memberi (§0.7).
  baseRole        BaseRole?
  description     String?           @db.Text
  /// `users.id` pembuatnya. Sengaja tanpa relasi/FK: role bawaan tidak punya pembuat,
  /// dan menghapus user tidak boleh menyeret role yang dibuatnya.
  createdById     Int?
  /// docs/custom_roles.md §F16 — terisi HANYA pada baris "override" milik satu
  /// company: klon company itu atas sebuah role bawaan, dibuat otomatis saat admin
  /// company pertama kali mengedit permission role bawaan. Menunjuk `id` baris
  /// bawaan (global, `companyId IS NULL`) yang digantikannya. NULL untuk role
  /// bawaan itu sendiri DAN untuk role custom biasa (bukan hasil override).
  overridesRoleId Int?

  company         company?          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  /// Self-relation ke baris bawaan yang di-override. Tanpa `onDelete` eksplisit
  /// (default Postgres: `NO ACTION`) — role bawaan tidak pernah benar-benar
  /// dihapus (trigger `accessLevel_no_delete_system`), jadi cascade di sini tidak
  /// pernah punya kesempatan bekerja; override sendiri hanya SOFT delete
  /// (`status = 0`, lihat `RolesService.revertBuiltInOverride`).
  overridesRole   accessLevel?      @relation("AccessLevelOverride", fields: [overridesRoleId], references: [id])
  overriddenBy    accessLevel[]     @relation("AccessLevelOverride")
  rolePermissions rolePermission[]
  userAccessLevel userAccessLevel[]
  /// docs/table_field_visibility.md §3.2 — override per role. NULL di
  /// `tableFieldVisibility.accessLevelId` = default se-company, tidak muncul di sini.
  tableFieldVisibilities tableFieldVisibility[]

  // Keunikan `code` TIDAK dinyatakan di sini: `@@unique([companyId, code])` bocor karena
  // di Postgres NULL <> NULL, jadi dua role global bercode sama tetap lolos. Penggantinya
  // dua partial unique index manual (§3.4) — `accessLevel_global_code_key` dan
  // `accessLevel_company_code_key`, keduanya di apply-partial-indexes.js.
  //
  // Keunikan `(companyId, overridesRoleId)` — paling banyak satu override AKTIF per
  // role bawaan per company — juga TIDAK dinyatakan di sini untuk alasan yang sama:
  // partial unique index manual `accessLevel_company_override_key` (§F16), di
  // apply-partial-indexes.js.
  @@index([companyId, status])
}

/// Tiga tingkat yang bisa dipilih admin saat membuat role custom (§0.2, §0.5).
/// SYSTEM_ADMIN / SUPER_ADMIN / GUEST sengaja tidak ditawarkan — mencegah eskalasi.
enum BaseRole {
  ADMIN
  MANAGER
  STAFF
}

enum PermissionAction {
  READ
  WRITE
  DELETE
}

/// Satu baris = satu centang di matriks: role X boleh `action` pada `featureKey`.
/// `featureKey` sengaja String, bukan enum: daftar fitur (§4.1) hidup di kode, dan
/// menambah fitur baru tidak boleh menuntut migration enum.
model rolePermission {
  id            Int              @id @default(autoincrement())
  uuid          String           @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  accessLevelId Int
  featureKey    String           @db.VarChar(64)
  action        PermissionAction
  createdAt     DateTime         @default(dbgenerated("NOW()"))

  accessLevel accessLevel @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)

  @@unique([accessLevelId, featureKey, action])
  @@index([accessLevelId])
}

model userAccessLevel {
  id            Int          @id @default(autoincrement())
  uuid          String       @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  userId        Int
  accessLevelId Int
  companyId     Int
  createdAt     DateTime     @default(dbgenerated("NOW()"))
  updatedAt     DateTime?    @default(dbgenerated("NOW()"))
  status        Int
  user          users?       @relation(fields: [userId], references: [id], onDelete: Cascade)
  accessLevel   accessLevel? @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)
  company       company?     @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([userId, status]) // RolesGuard: lookup access level per user di tiap request
  @@index([accessLevelId])
  @@index([companyId])
  // "Satu role per user per company" (§0.8) dijaga partial unique index
  // `userAccessLevel_one_active_per_company` (WHERE "status" = 1) — tidak bisa
  // dinyatakan di sini, jadi ia hidup di migration SQL + apply-partial-indexes.js.
  // Tanpa index itu, 24 pembacaan `userAccessLevel[0]` tanpa `orderBy` memilih role
  // yang menang berdasar urutan yang kebetulan dikembalikan Postgres (§3.4a).
}

model company {
  id                         Int                         @id @default(autoincrement())
  uuid                       String                      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  name                       String                      @db.VarChar(255)
  telp                       String?                     @db.VarChar(255)
  address                    String?                     @db.Text
  websiteURL                 String?                     @db.Text
  register_name              String?                     @db.VarChar(255)
  register_email             String?                     @db.VarChar(50)
  register_roles             String?                     @db.VarChar(255)
  register_total_employees   String?                     @db.VarChar(255)
  timeZone                   String                      @default("UTC") @db.VarChar(255)
  currency                   String                      @default("USD") @db.VarChar(10)
  workweekStartDay           Int                         @default(1) // 0=Sunday, 1=Monday, ..., 6=Saturday
  dailyReportSentAt          DateTime                    @default(dbgenerated("TIME '00:00:00'")) @db.Time
  isAlllowDeleteScreenshot   Boolean                     @default(false)
  fixedHourNotification      Int                         @default(4)
  isAgencyMode               Boolean                     @default(false)
  isTrial                    Boolean                     @default(false)
  maxUsers                   Int                         @default(0)
  maxProject                 Int                         @default(0)
  // Old feature-gating columns (kept for backward compatibility)
  useIdleDetection           Boolean?
  useCheatDetection          Boolean?
  useReports                 Boolean?
  useTimesheetApproval       Boolean?
  useActivityLevel           Boolean?
  useIntegrations            Boolean?
  // Usage-gating limits (synced from pricingTiers on subscription change)
  screenshotResolution       String                      @default("640x360") @db.VarChar(20)
  screenshotRetentionDays    Int                         @default(7)
  reportExportsPerMonth      Int                         @default(3)
  reportExportsUsedThisMonth Int                         @default(0)
  reportExportsResetAt       DateTime?
  dataHistoryMonths          Int                         @default(3)
  budgetAlertDeliveryChannel BudgetAlertDeliveryChannel  @default(INAPP_ONLY)
  clientProofExportAllowed   Boolean                     @default(false)
  createdAt                  DateTime                    @default(dbgenerated("NOW()"))
  updatedAt                  DateTime?                   @default(dbgenerated("NOW()"))
  status                     Int
  actualProfilePictureName   String?                     @db.Text()
  profilePictureFullPath     String?                     @db.Text()
  hasCreateOrgnanization     Boolean                     @default(false)
  inviteCode                 String?                     @unique @db.VarChar(12)
  dontChargeInvite           Boolean                     @default(false)
  clickupApiToken            String?                     @db.Text
  clickupWorkspaceId         String?                     @db.VarChar(255)
  jiraAccessToken            String?                     @db.Text
  jiraRefreshToken           String?                     @db.Text
  jiraCloudId                String?                     @db.VarChar(255)
  jiraSiteUrl                String?                     @db.VarChar(512)
  jiraTokenExpiresAt         DateTime?
  jiraWebhookId                      Int?
  jiraWebhookSecret                  String?                     @db.VarChar(128)
  discordGuildId                     String?                     @unique @db.VarChar(255)
  discordGuildName                   String?                     @db.VarChar(255)
  discordDefaultTaskChannelId        String?                     @db.VarChar(255)
  discordDefaultTaskChannelName      String?                     @db.VarChar(255)
  googleCalendarAccessToken          String?                     @db.Text
  googleCalendarRefreshToken         String?                     @db.Text
  googleCalendarTokenExpiresAt       DateTime?
  googleCalendarEmail                String?                     @db.VarChar(255)
  googleCalendarSyncToken            String?                     @db.Text
  googleCalendarWebhookChannelId     String?                     @db.VarChar(255)
  googleCalendarWebhookResourceId    String?                     @db.VarChar(255)
  googleCalendarWebhookExpiry        DateTime?
  // Mobile attendance settings
  mobileRequireSelfie                Boolean                     @default(false)
  mobileBlockMockLocation            Boolean                     @default(false)
  // Jeda (menit) aplikasi mobile mengirim riwayat lokasi yang terkumpul ke server.
  // Hanya dibaca aplikasi lewat GET /mobile/company/config; server tidak menegakkannya.
  locationHistorySyncIntervalMinutes Int                         @default(15)
  // Aplikasi mobile boleh bekerja offline (menarik katalog lewat endpoint sync
  // lalu mengantre aksi saat tidak ada jaringan). Default false = opt-in: hari
  // deploy tidak ada company yang berubah perilakunya, dan admin internal yang
  // menyalakannya per company lewat PATCH /admin-company/set/offline-mode/:uuid.
  isSupportOfflineMode               Boolean                     @default(false)
  // false = log app & URL dari desktop (POST /activity-logs) diterima tapi
  // tidak disimpan ke tabel app/url.
  useActivityTrack                   Boolean                     @default(false)
  // Image blur settings
  imageBlurEnabled                   Boolean                     @default(false)
  imageBlurRoles                     String[]
  // Store visit settings
  storeVisitDefaultRadiusMeters      Int                         @default(150)
  storeVisitMaxAccuracyMeters        Int                         @default(100)
  storeVisitBlockMockLocation        Boolean                     @default(true)
  storeVisitRequirePhotos            Boolean                     @default(true)
  storeVisitAllowOverride            Boolean                     @default(false)
  storeVisitMaxDurationHours         Int                         @default(8)
  // §0.23, §2.6 store_visit_grouping.md — default false = perilaku fail-open (§0.5)
  // apa adanya, hari deploy tidak berubah sedikit pun.
  storeVisitEnforceGroupScope        Boolean                     @default(true)
  // Menit minimum antara check-in dan check-out sebuah kunjungan. 0 = mati, yang
  // merupakan perilaku apa adanya sebelum kolom ini ada.
  storeVisitMinDurationMinutes       Int                         @default(0)
  // true = check-in kunjungan toko membuka mobileShift otomatis, sehingga sales
  // tercatat hadir tanpa harus absen di geofence kantor. Default false supaya hari
  // deploy tidak mengubah kehadiran siapa pun.
  storeVisitCountsAsAttendance       Boolean                     @default(false)
  /// docs/store_visit_form_revisers.md §0.4. Default `allPrivileged` DISENGAJA: migration ini
  /// tidak boleh mengubah perilaku satu company pun. Perpindahan ke `selected` selalu
  /// tindakan admin yang tercatat di audit.
  storeVisitFormReviseMode           StoreVisitFormReviseMode    @default(allPrivileged)
  /// specs/005-manual-time-approval-settings. Default `ALL` = perilaku hari ini (semua manual time
  /// butuh approval), jadi migration ini tidak mengubah satu company pun.
  manualTimeApprovalMode             ManualTimeApprovalMode      @default(ALL)
  /// Kelipatan 15. Dengan `DAY`: 15–1440. Dengan `WEEK`: 15–10080. Wajib terisi saat mode `LIMIT`.
  /// Tidak pernah dikosongkan ketika mode berubah.
  manualTimeAutoApproveLimitMinutes  Int?
  manualTimeAutoApprovePeriod        ManualTimeLimitPeriod       @default(DAY)
  manualTimeAutoApproveNewEmployees  Boolean                     @default(true)
  manualTimeApprovalExceptions       manualTimeApprovalException[]
  // specs/006-employee-divisions FR-030: saklar pilot per company.
  divisionsEnabled                   Boolean                     @default(false)
  divisions                          division[]
  divisionMembers                    divisionMember[]
  // Modul besar yang aktif di company ini. Keduanya `true` = perilaku apa adanya,
  // jadi hari deploy tidak mematikan apa pun bagi company yang sudah ada. Aturan
  // "minimal satu aktif" dijaga di dua tempat: transaksi di companies.service.ts
  // dan CHECK constraint `company_at_least_one_module` di database — yang kedua
  // menutup jalur tulis lain (admin-company, script) yang tidak lewat service itu.
  moduleTimeTrackingEnabled          Boolean                     @default(true)
  moduleSalesTrackerEnabled          Boolean                     @default(true)
  /// @deprecated not read since 006-roles-show-all; drop in a manual migration
  customRolesEnabled                 Boolean                     @default(false)
  // docs/order_design.md §5.4 (F1) — batas persentase diskon order, NULL = tanpa
  // batas. WAJIB dicerminkan di CompaniesEntity, atau `tsc` gagal TS2420.
  maxOrderDiscountPercent            Decimal?                    @db.Decimal(5, 2)
  userCompany                        userCompany[]
  projectCompany             projectCompany[]
  userAccessLevel            userAccessLevel[]
  accessLevels               accessLevel[]
  companyClient              companyClient[]
  trial                      trials[]
  subscriptions              subscriptions[]
  dailyCompanySummary        dailyCompanySummary[]
  scheduledReports           scheduledReport[]
  userPayRates               userPayRate[]
  timesheets                 timesheet[]
  userWorkTimeLimits         userWorkTimeLimit[]
  timesheetInvoices          timesheetInvoice[]
  workLimitBreaches          workLimitBreach[]
  managerSummaryConfig       managerSummaryConfig?
  defaultManualTimeApprovers defaultManualTimeApprover[]
  projectClickupMappings     projectClickupMapping[]
  userClickupMappings        userClickupMapping[]
  projectJiraMappings                projectJiraMapping[]
  userJiraMappings                   userJiraMapping[]
  projectDiscordMappings             projectDiscordMapping[]
  userDiscordMappings                userDiscordMapping[]
  tasks                              task[]
  googleCalendarEvents               googleCalendarEvent[]
  mobileShifts                       mobileShift[]
  mobileBreakPolicy                  mobileBreakPolicy?
  geofences                          geofence[]
  negativeZones                      negativeZone[]
  leavePolicy                        leavePolicy?
  employeeLeavePolicies              employeeLeavePolicy[]
