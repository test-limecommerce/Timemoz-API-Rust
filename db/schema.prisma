  manageStoreAt    DateTime?
  visitPlanAt      DateTime?
  finishAt         DateTime?
  completedAt      DateTime?
  /// Email pengingat quickstart hanya untuk company yang lahir setelah fitur ini
  /// (`initForCompany` mengisi true); baris lama tetap false = user lama tidak dikirimi.
  reminderEligible Boolean   @default(false)
  createdAt        DateTime  @default(now())
  updatedAt        DateTime  @default(now()) @updatedAt
  company          company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
