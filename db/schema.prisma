/// Jejak email pengingat quickstart: satu baris per (company, jenis). Unique
/// itulah klaimnya — replika lain yang mencoba jenis yang sama mendapat konflik.
model companyQuickstartEmail {
  id         Int                    @id @default(autoincrement())
  companyId  Int
  type       QuickstartReminderType
  status     String                 @default("SENDING") @db.VarChar(20) // SENDING | SENT | FAILED
  attempts   Int                    @default(1)
  claimedAt  DateTime               @default(now())
  sentAt     DateTime?
  /// [{ userId, email, success }] — siapa saja yang dikirimi pada percobaan terakhir.
  recipients Json?
  lastError  String?                @db.Text
  createdAt  DateTime               @default(now())
  updatedAt  DateTime               @default(now()) @updatedAt
  company    company                @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, type])
}

/// Boost batas paket per company (`PATCH /admin-company/set/plan-boost/:uuid`):
/// admin internal menaikkan sementara batas SALES atau TIME supaya company tertentu
/// bisa mencoba lebih banyak, lalu mengembalikannya. Nilai boost-nya konstanta di
/// `src/plan-limits/plan-boost.ts`.
///
/// Batas SALES dibaca dari `pricingTiers` yang DIPAKAI BERSAMA banyak company, jadi
/// boost-nya override saat dibaca (`enabled` dicek di `resolvePlanEntitlements`) —
/// baris paket tidak pernah disentuh. Batas TIME (dan `storeVisitCountsAsAttendance`
/// untuk SALES) adalah kolom `company`, jadi ditimpa langsung: nilai sebelumnya
/// disimpan di `previousValues`, nilai yang ditulis di `boostedValues`, dan saat
/// dimatikan sebuah kolom hanya dikembalikan kalau isinya masih sama dengan
/// `boostedValues` (kalau tidak, billing/admin sudah mengubahnya selama boost).
model companyPlanBoost {
  id                  Int                @id @default(autoincrement())
  companyId           Int
  product             PricingProductType // SALES | TIME — FULL ditolak DTO
  enabled             Boolean            @default(false)
  previousValues      Json?
  boostedValues       Json?
  enabledAt           DateTime?
  disabledAt          DateTime?
  updatedByOperatorId Int?
  createdAt           DateTime           @default(now())
  updatedAt           DateTime           @default(now()) @updatedAt
  company             company            @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@unique([companyId, product])
}

