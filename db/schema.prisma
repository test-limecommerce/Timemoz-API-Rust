  trackingId            Int
  projectId             Int
  createdAt             DateTime                  @default(dbgenerated("NOW()"))
  updatedAt             DateTime?                 @default(dbgenerated("NOW()"))
  status                Int
  manualTimeStatus      ManualTimeStatus?
  /// Terisi hanya bersama `manualTimeStatus = APPROVED`. `null` pada baris APPROVED = legacy,
  /// dibaca sebagai `MANUAL`.
  manualTimeApprovalSource ManualTimeApprovalSource?
  reason                String?                   @db.Text
  approvedById          Int?
  approvedAt            DateTime?
  rejectedReason        String?                   @db.Text
  requestedAt           DateTime?
