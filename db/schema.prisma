  productType                PricingProductType         @default(FULL) // paket ini dijual untuk produk yang mana
  paypalPlanId               String?                    @db.VarChar(100)
  paypalProductId            String?                    @db.VarChar(100)
  createdAt                  DateTime                   @default(dbgenerated("NOW()"))
  updatedAt                  DateTime?                  @default(dbgenerated("NOW()"))
  status                     Int
  maxProject                 Int                        @default(0)
  maxAppUrlPerUser           Int                        @default(0)
  // Old feature-gating columns (kept for backward compatibility)
  useIdleDetection           Boolean?
  useCheatDetection          Boolean?
  useReports                 Boolean?
  useTimesheetApproval       Boolean?
  useActivityLevel           Boolean?
  useIntegrations            Boolean?
  // Usage-gating limits
  screenshotResolution       String                     @default("640x360") @db.VarChar(20) // e.g., "640x360" or "1920x1080"
  screenshotRetentionDays    Int                        @default(7) // 7 for free, unlimited for pro (represented as -1 or high number)
  reportExportsPerMonth      Int                        @default(3) // 3 for free, -1 for unlimited
  dataHistoryMonths          Int                        @default(3) // 3 for free, -1 for unlimited
  budgetAlertDeliveryChannel BudgetAlertDeliveryChannel @default(INAPP_ONLY) // INAPP_ONLY or EMAIL_SLACK
  clientProofExportAllowed   Boolean                    @default(false) // can export PDF or just view
  // Batas & gerbang fitur Sales Tracker
  maxStores                  Int                        @default(10) // jumlah toko yang boleh dibuat
  totalGeofence              Int                        @default(2) // jumlah geofence yang boleh dibuat
  auditLog                   Boolean                    @default(false)
  divisions                  Boolean                    @default(false) // specs/006-employee-divisions FR-029
  form                       Boolean                    @default(false)
  timelineRoute              Boolean                    @default(false)
  product                    Boolean                    @default(false)
  order                      Boolean                    @default(false)
  // Default 0 (tanpa batas) supaya migration ini tidak diam-diam mengunci paket
  // berbayar yang sudah berjalan ke angka FREE — beda dari maxStores/totalGeofence
  // di atas, yang default-nya belum ditegakkan kode apa pun saat kolomnya masuk.
  // Ketiga kolom ini DITEGAKKAN oleh perubahan yang sama, jadi paket FREE harus
  // disetel manual lewat SQL (mis. maxAutoCheckIns=100, maxFormTemplates=1,
  // visitHistoryDays=7) setelah migration ini jalan.
  maxAutoCheckIns            Int                        @default(0) // jumlah check-in otomatis (ping GPS §3.1) seumur langganan; 0/negatif = tanpa batas
  maxFormTemplates           Int                        @default(0) // jumlah storeVisitFormTemplate; 0/negatif = tanpa batas
  visitHistoryDays           Int                        @default(0) // jendela riwayat kunjungan yang TERLIHAT, dalam hari; 0 = tanpa batas. Data lama tidak dihapus, hanya disunat dari query.
  listFeatures               Json?
  subscriptions              subscriptions[]
}

