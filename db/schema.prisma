  project               project?                  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  approvedBy            users?                    @relation("ManualTimeApprover", fields: [approvedById], references: [id])
  linkedTask            task?                     @relation("LinkedTask", fields: [taskId], references: [id])
