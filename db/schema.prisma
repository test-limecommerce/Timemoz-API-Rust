  @@index([status, projectId, timezone, startAt, endAt]) // Data lama (timezone IS NULL)
  @@index([status, projectId, timezone, startAtUtc, endAtUtc]) // Data baru (timezone IS NOT NULL)
  @@index([trackingId]) // JOIN ke tracking
  @@index([trackingId, startAt]) // Overlap/kuota/batas jam per pemilik: tracking milik user lalu rentang startAt
  @@index([manualTimeStatus, projectId])
  @@index([taskId])
}

