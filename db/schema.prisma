// Customer (induk toko) — docs/customers.md. Level ACCOUNT, bukan outlet: badan
// usaha/pemilik yang bisa punya banyak store. Tidak pernah masuk perhitungan
// scope/otorisasi (§2 docs/customers.md) — murni kepemilikan, beda dimensi dari
// storeGroup yang murni wilayah/akses.
model customerType {
  id          Int        @id @default(autoincrement())
  uuid        String     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String     @db.VarChar(32)
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true)

  createdById Int
  createdAt   DateTime   @default(dbgenerated("NOW()"))
  updatedAt   DateTime?  @default(dbgenerated("NOW()"))

  company     company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   users      @relation("CustomerTypeCreatedBy", fields: [createdById], references: [id])
  customers   customer[]

  // Tanpa `deletedAt` (docs/customers.md §0.5): diarsip lewat `isActive`, jadi
  // unique-nya index biasa, bukan partial index manual.
  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model customerGroup {
  id          Int        @id @default(autoincrement())
  uuid        String     @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String     @db.VarChar(32)
  name        String     @db.VarChar(120)
  description String?    @db.VarChar(255)
  isActive    Boolean    @default(true)

  createdById Int
  createdAt   DateTime   @default(dbgenerated("NOW()"))
  updatedAt   DateTime?  @default(dbgenerated("NOW()"))

  company     company    @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   users      @relation("CustomerGroupCreatedBy", fields: [createdById], references: [id])
  customers   customer[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model customerChannel {
  id           Int                  @id @default(autoincrement())
  uuid         String               @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    Int
  code         String               @db.VarChar(32)
  name         String               @db.VarChar(120)
  description  String?              @db.VarChar(255)
  isActive     Boolean              @default(true)

  createdById  Int
  createdAt    DateTime             @default(dbgenerated("NOW()"))
  updatedAt    DateTime?            @default(dbgenerated("NOW()"))

  company      company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    users                @relation("CustomerChannelCreatedBy", fields: [createdById], references: [id])
  customers    customer[]
  subChannels  customerSubChannel[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

// `code` unik per company, bukan per channel (docs/customers.md §3.2) — kode yang
// sama di dua channel berbeda membuat dropdown dan import by-code ambigu.
model customerSubChannel {
  id          Int             @id @default(autoincrement())
  uuid        String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String          @db.VarChar(32)
  name        String          @db.VarChar(120)
  description String?         @db.VarChar(255)
  isActive    Boolean         @default(true)
  channelId   Int

  createdById Int
  createdAt   DateTime        @default(dbgenerated("NOW()"))
  updatedAt   DateTime?       @default(dbgenerated("NOW()"))

  company     company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   users           @relation("CustomerSubChannelCreatedBy", fields: [createdById], references: [id])
  // Restrict, bukan Cascade: channel yang masih punya sub channel tidak bisa
  // dihapus, dan tidak ada endpoint hard delete (docs/customers.md §3.2, §5.4).
  channel     customerChannel @relation(fields: [channelId], references: [id], onDelete: Restrict)
  customers   customer[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, channelId, isActive])
}

model customer {
  id           Int                  @id @default(autoincrement())
  uuid         String               @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    Int
  code         String               @db.VarChar(32)
  name         String               @db.VarChar(160)
  // Opsional sejak 3 Sep 2026 (docs/customers.md §14). Semula wajib (§3.3), tapi
  // sumber customer yang paling banyak — data pemilik yang sudah ada di `store` —
  // tidak punya padanan tipe sama sekali, jadi kewajibannya cuma memaksa lahirnya
  // satu tipe penampung yang tidak berarti apa-apa. Keempat FK master kini seragam.
  typeId       Int?
  groupId      Int?
  channelId    Int?
  subChannelId Int?
  taxNumber    String?              @db.VarChar(32)
  phone        String?              @db.VarChar(20)
  isActive     Boolean              @default(true)
  /// docs/product_master.md §0.27 — SATU customer menunjuk TEPAT SATU price list;
  /// yang NULL memakai price list default company (`priceList.isDefault`). "Harga
  /// khusus customer" karena itu berbentuk *customer diarahkan ke daftar harga
  /// tertentu*, bukan harga yang diketik satu per satu per customer. Diskon volume
  /// ditangani tier `minQty`/`maxQty` di dalam price list-nya (§7.5).
  priceListId  Int?

  createdById  Int
  deletedAt    DateTime?
  createdAt    DateTime             @default(dbgenerated("NOW()"))
  updatedAt    DateTime?            @default(dbgenerated("NOW()"))

  company      company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy    users                @relation("CustomerCreatedBy", fields: [createdById], references: [id])
  type         customerType?        @relation(fields: [typeId], references: [id], onDelete: Restrict)
  group        customerGroup?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  channel      customerChannel?     @relation(fields: [channelId], references: [id], onDelete: Restrict)
  subChannel   customerSubChannel?  @relation(fields: [subChannelId], references: [id], onDelete: Restrict)
  priceList    priceList?           @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  stores       store[]
  // docs/order_design.md §0.9 (F1) — jangkar wajib order.
  orders       order[]

  // TIDAK memakai @@unique([companyId, code]) — unique-nya partial (§3.5
  // docs/customers.md), sama pola dengan store.code. Ditulis manual di migration
  // SQL: "customer_code_unique_per_company". Prisma tidak mendukung partial index
  // — jangan hapus index itu saat regenerate.
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, typeId])
  @@index([companyId, groupId])
  @@index([companyId, channelId])
  @@index([companyId, priceListId])
  /// F9 docs/product_master.md §10.2/§10.4 — `customer` is the keyset source for the
  /// mobile catalog's `assignments` delta stream (§0.33) and one leg of the
  /// `catalogToken` aggregate. Added now, not in F1: F1 only indexed the 13 tables it
  /// created; `customer` predates this plan and this index exists purely to serve F9.
  @@index([companyId, updatedAt, id])
}

// Store grouping (region). Group adalah konfigurasi, kunjungan adalah bukti (§1.1
// docs/store_visit_grouping.md) — baris di sini boleh diubah kapan saja tanpa jejak
// khusus, berbeda dengan storeVisit.storeGroupId yang ditulis sekali saat check-in.
model storeGroup {
  id          Int              @id @default(autoincrement())
  uuid        String           @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String           @db.VarChar(32)
  name        String           @db.VarChar(120)
  description String?          @db.VarChar(255)
  isActive    Boolean          @default(true)

  createdById Int
  createdAt   DateTime         @default(dbgenerated("NOW()"))
  updatedAt   DateTime?        @default(dbgenerated("NOW()"))

  company     company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   users            @relation("StoreGroupCreatedBy", fields: [createdById], references: [id])
  stores      store[]
  members     storeGroupUser[]
  visits      storeVisit[]
  // docs/order_design.md §3.5 (F1) — snapshot storeGroupId toko saat order dibuat.
  orders      order[]

  // Tanpa `deletedAt` (§0.8): dihapus lewat arsip (isActive), bukan soft delete, jadi
  // unique-nya index biasa, bukan partial index manual.
  @@unique([companyId, code])
  @@index([companyId, isActive])
}

// Assignment sales ↔ group. Tanpa relasi ke `users` (satu-satunya pengecualian §0.15):
// penghapusan user tidak boleh gagal hanya karena ada baris assignment. Konsekuensinya
// wajib ditangani di service — lihat §2.3 docs/store_visit_grouping.md.
model storeGroupUser {
  id        Int        @id @default(autoincrement())
  groupId   Int
  userId    Int
  createdAt DateTime   @default(dbgenerated("NOW()"))
  // Soft delete (§2.4.1 docs/audit_log.md). Pencabutan sales dari region tidak lagi
  // menghapus barisnya — tanpa baris yang tersisa, restore tidak punya apa pun untuk
  // dihidupkan lagi. SETIAP pembacaan tabel ini WAJIB menyaring `deletedAt: null`;
  // yang lupa tidak melempar error, ia cuma memunculkan kembali sales yang sudah
  // dicabut — dan salah satu pembacanya penentu hak akses, bukan tampilan (§9.4).
  deletedAt DateTime?

  // Cascade: baris assignment adalah konfigurasi, bukan bukti (§1.1).
  group     storeGroup @relation(fields: [groupId], references: [id], onDelete: Cascade)

  // `@@unique([groupId, userId])` DICABUT (§2.4.2 docs/audit_log.md): sejak barisnya
  // tidak lagi pergi, constraint penuh akan menolak sales yang dimasukkan lagi ke
  // region yang pernah mencabutnya. Penggantinya partial unique index — yang tidak bisa
  // dinyatakan Prisma — "storeGroupUser_member_unique_active" (WHERE "deletedAt" IS
  // NULL), ada di migration SQL dan di prisma/apply-partial-indexes.js. Index itu
  // sekaligus melayani pencarian per (groupId, userId), selama query-nya menyaring
  // `deletedAt: null`.
  @@index([userId])
}

model store {
  id              Int               @id @default(autoincrement())
  uuid            String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       Int
  code            String            @db.VarChar(32)
  name            String            @db.VarChar(120)
  ownerName       String            @db.VarChar(80)
  phone           String?           @db.VarChar(20)
  address         String            @db.VarChar(255)
  lat             Float
  lng             Float
  radiusMeters    Int?
  qrToken         String?           @unique @db.VarChar(64)
  isActive        Boolean           @default(true)
  groupId         Int?
  customerId      Int?

  totalVisits     Int               @default(0)
  lastVisitAt     DateTime?
  lastVisitStatus StoreVisitStatus?

  createdById     Int
  deletedAt       DateTime?
  createdAt       DateTime          @default(dbgenerated("NOW()"))
  updatedAt       DateTime?         @default(dbgenerated("NOW()"))

  company         company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy       users             @relation(fields: [createdById], references: [id])
  // Tanpa FK ke deletion: satu-satunya endpoint hapus group adalah arsip (§0.10), jadi
  // Restrict di sini murni jaring pengaman terhadap DELETE manual di database.
  group           storeGroup?       @relation(fields: [groupId], references: [id], onDelete: Restrict)
  // Restrict sama alasannya dengan groupId (docs/customers.md §3.4): satu-satunya
  // jalur hapus customer adalah arsip + soft delete lewat API, jadi FK ini murni
  // jaring pengaman terhadap DELETE manual di database.
  customer        customer?         @relation(fields: [customerId], references: [id], onDelete: Restrict)
  visits          storeVisit[]
  auditLogs       storeVisitAuditLog[]
  locationEvents  storeVisitLocationEvent[]
  plans           storeVisitPlan[]
  // docs/order_design.md §0.9 (F1) — tempat kirim / lokasi transaksi, opsional.
  orders          order[]
  noOrders        storeVisitNoOrder[]

  // TIDAK memakai @@unique([companyId, code]) — unique-nya partial
  // (WHERE "deletedAt" IS NULL) supaya kode store yang sudah di-soft-delete bisa
  // dipakai ulang. Ditulis manual di migration SQL: "store_code_unique_per_company".
  // Prisma tidak mendukung partial index — jangan hapus index itu saat regenerate.
  @@index([companyId, isActive])
  @@index([companyId, deletedAt])
  @@index([companyId, lat, lng])
  // Menopang filter admin per region DAN klausa scope mobile (§4.1 store_visit_grouping.md).
  @@index([companyId, groupId, isActive])
  @@index([companyId, customerId])
}

model storeVisit {
  id                    Int               @id @default(autoincrement())
  uuid                  String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId             Int
  storeId               Int
  userId                Int
  visitNumber           String            @db.VarChar(32)
  clientRequestId       String            @db.Uuid

  state                 StoreVisitState   @default(active)
  status                StoreVisitStatus?
  note                  String?           @db.Text
  tags                  String[]          @default([])
  durationSeconds       Int?
  // Snapshot storeGroupId toko saat check-in (§0.11, §2.4 store_visit_grouping.md).
  // Nullable selamanya: toko tanpa region (§0.6) menghasilkan kunjungan tanpa region,
  // dan itu keadaan yang sah, bukan data rusak. Tidak pernah ditulis ulang.
  storeGroupId          Int?
  // Jadwal yang dipenuhi kunjungan ini (§0.4, §0.5 docs/store_visit_schedule.md). NULL =
  // kunjungan di luar jadwal, dan itu keadaan yang sah — jadwal bersifat panduan (§0.1),
  // bukan pagar.
  //
  // Ditulis sekali saat check-in, dan dikosongkan sekali kalau kunjungan dibatalkan
  // (§0.6). Tidak pernah disentuh selain itu — termasuk oleh auto-close, yang
  // menghasilkan kunjungan `completed` dan karena itu tetap memenuhi jadwalnya.
  planId                Int?              @unique

  checkInAt             DateTime
  checkInClientAt       DateTime?
  checkInLat            Float
  checkInLng            Float
  checkInAccuracy       Float
  checkInDistance       Int
  checkInMethod         StoreVisitMethod  @default(gps)
  checkInGpsValidation  GpsValidation
  checkInIsMock         Boolean           @default(false)
  checkInIsOverride     Boolean           @default(false)
  checkInOverrideReason String?           @db.VarChar(255)

  // Kolom turunan, diisi sekali saat check-in: gpsValidation != valid OR isMock OR isOverride.
  // Menghindari OR tiga kolom di setiap query KPI — sekali tulis, gratis dibaca, bisa di-index.
  hasGpsIssue           Boolean           @default(false)

  checkOutAt            DateTime?
  checkOutClientAt      DateTime?
  checkOutLat           Float?
  checkOutLng           Float?
  checkOutAccuracy      Float?
  checkOutDistance      Int?
  checkOutGpsValidation GpsValidation?
  checkOutIsMock        Boolean?

  createdAt             DateTime          @default(dbgenerated("NOW()"))
  updatedAt             DateTime?         @default(dbgenerated("NOW()"))

  company               company           @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store                 store             @relation(fields: [storeId], references: [id])
  // Restrict, BUKAN Cascade: riwayat kunjungan adalah bukti kerja lapangan, dan
  // cascade delete akan menghapus baris tanpa mengurangi store.totalVisits.
  user                  users             @relation(fields: [userId], references: [id], onDelete: Restrict)
  // Restrict: memindahkan sejarah bukan tugas hard delete group (§0.10, §2.4).
  storeGroup            storeGroup?       @relation(fields: [storeGroupId], references: [id], onDelete: Restrict)
  // Restrict, BUKAN Cascade atau SetNull. Menghapus jadwal yang sudah tercapai berarti
  // mengubah kunjungan yang sah jadi `unplanned` secara retroaktif (§0.8 store_visit_schedule.md);
  // database yang menolaknya, supaya balapan §5.4 tidak punya jendela sama sekali.
  plan                  storeVisitPlan?   @relation(fields: [planId], references: [id], onDelete: Restrict)
  // docs/visit_masters.md §0.13 — SNAPSHOT dari jadwal yang diklaim saat check-in.
  // NULL = kunjungan di luar jadwal, atau jadwal tanpa tipe.
  visitTypeId           Int?
  visitType             visitType?        @relation(fields: [visitTypeId], references: [id], onDelete: Restrict)
  photos                storeVisitPhoto[]
  auditLogs             storeVisitAuditLog[]
  locationEvents        storeVisitLocationEvent[]
  // docs/order_design.md §0.9 (F1) — konteks lapangan, opsional. `noOrder` satu-ke-satu
  // (storeVisitNoOrder.storeVisitId unik): satu kunjungan paling banyak satu pernyataan.
  orders                order[]
  noOrder               storeVisitNoOrder?

  // Satu kunjungan aktif per sales dijamin partial unique index manual
  // "storeVisit_one_active_per_user" (WHERE "state" = 'active') di migration SQL.
  @@unique([companyId, visitNumber])
  @@unique([userId, clientRequestId])
  @@index([companyId, checkInAt])
  @@index([userId, checkInAt])
  @@index([storeId, checkInAt])
  @@index([companyId, state])
  @@index([companyId, hasGpsIssue])
  // Menopang breakdown per region pada rentang tanggal (§4.3 store_visit_grouping.md).
  @@index([companyId, storeGroupId, checkInAt])
  // Menopang filter `planned=false` pada daftar kunjungan admin (§4.2 store_visit_schedule.md).
  // Kolomnya sudah ber-unique-index, tapi unique index atas satu kolom nullable tidak
  // menolong query yang memfilter per company.
  @@index([companyId, planId])
}

// Jadwal kunjungan: satu baris = satu kewajiban seorang sales pada satu tanggal untuk
// satu toko. Konfigurasi, bukan bukti (§1.1 docs/store_visit_schedule.md) — boleh
// dihapus, KECUALI kalau sudah diklaim sebuah kunjungan; itu dijaga FK
// `storeVisit.planId` (Restrict), bukan hanya service.
model storeVisitPlan {
  id          Int         @id @default(autoincrement())
  uuid        String      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  // Sales yang dijadwalkan. TANPA @relation — satu-satunya pengecualian di modul ini,
  // dan alasannya sama persis dengan storeGroupUser.userId (§0.15 store_visit_grouping.md):
  // penghapusan user tidak boleh gagal karena ada baris jadwal. Konsekuensinya ditangani
  // di service (§5.6 store_visit_schedule.md).
  userId      Int
  storeId     Int
  // Tanggal kalender UTC polos, BUKAN momen dan BUKAN zona waktu company (§0.13, §0.18
  // store_visit_schedule.md). Pola persis `tracking.takenDate`. Baca §1.4 sebelum
  // menulis satu baris pun kode yang menyentuh kolom ini.
  visitDate   DateTime    @db.Date
  // Urutan kunjungan dalam sehari (§0.14). NULL = tidak diurutkan; diurutkan belakangan.
  sortOrder   Int?
  // Instruksi admin untuk kunjungan ini ("tagih invoice Juli", "pasang POSM baru").
  note        String?     @db.VarChar(255)
  // docs/visit_masters.md §0.12 — NULL = jadwal tanpa tipe (data lama, atau
  // company tanpa default). Dikunci setelah jadwal tercapai (§0.14).
  visitTypeId Int?

  createdById Int
  createdAt   DateTime    @default(dbgenerated("NOW()"))
  updatedAt   DateTime?   @default(dbgenerated("NOW()"))
  // Soft delete (§2.4.1 docs/audit_log.md), menggantikan hard delete di dua titik
  // `store-visit-plans.service.ts`. Satu konsekuensi tidak kelihatan dari sini: pagar
  // FK `Restrict` dari `storeVisit.planId` tidak ikut lagi — `UPDATE` tidak pernah
  // gagal dengan P2003 — jadi pemeriksaan "jadwal sudah tercapai" di service naik
  // status jadi satu-satunya penjaga (§2.4.4). Setiap pembacaan WAJIB menyaring
  // `deletedAt: null`.
  deletedAt   DateTime?

  company     company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store       store       @relation(fields: [storeId], references: [id])
  createdBy   users       @relation("StoreVisitPlanCreatedBy", fields: [createdById], references: [id])
  visitType   visitType?  @relation(fields: [visitTypeId], references: [id], onDelete: Restrict)
  // Relasi balik dari storeVisit.planId. Sisi FK-nya ada di storeVisit (§0.5).
  visit       storeVisit?

  // Satu kewajiban per (sales, tanggal, toko) — dan sejak §0.17 docs/audit_log.md ia
  // partial. `@@unique([userId, visitDate, storeId])` DICABUT (§2.4.2): baris yang
  // dihapus kini tinggal, jadi tanpa pencabutan itu menjadwalkan ulang slot yang jadwal
  // lamanya sudah dihapus akan ditolak P2002. Penggantinya
  // "storeVisitPlan_slot_unique_active" (WHERE "deletedAt" IS NULL), ada di migration
  // SQL dan di prisma/apply-partial-indexes.js.
  // Daftar & kalender admin: rentang tanggal per company.
  @@index([companyId, visitDate])
  // Laporan kepatuhan per toko, dan pemeriksaan "toko ini punya jadwal hari ini".
  @@index([storeId, visitDate])
  // docs/visit_masters.md §3.3 — daftar/filter jadwal admin per tipe kunjungan.
  @@index([companyId, visitTypeId])
}

// docs/visit_masters.md §3.1 — spec-sfa.md §25 Visit Type. Label + petunjuk untuk
// aplikasi; flag `requires*` BELUM ditegakkan server (§0.7).
model visitType {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     Int
  code          String    @db.VarChar(32) // REGULAR_VISIT, TAKING_ORDER, …
  name          String    @db.VarChar(120)
  description   String?   @db.VarChar(255)
  // §0.7 — informatif di v1, tidak ditegakkan di check-in/check-out.
  requiresOrder Boolean   @default(false)
  requiresPhoto Boolean   @default(false)
  requiresGps   Boolean   @default(true)
  sortOrder     Int       @default(0)
  // §0.8 — satu default per company: partial index manual
  // "visitType_one_default_per_company" (§3.5). Jangan hapus saat regenerate.
  isDefault     Boolean   @default(false)
  isActive      Boolean   @default(true)

  createdById   Int
  createdAt     DateTime  @default(dbgenerated("NOW()"))
  updatedAt     DateTime? @default(dbgenerated("NOW()"))

  company   company          @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users            @relation("VisitTypeCreatedBy", fields: [createdById], references: [id])
  plans     storeVisitPlan[]
  visits    storeVisit[]

  // Tanpa `deletedAt` (§0.3): diarsip lewat `isActive`, jadi unique-nya biasa.
  @@unique([companyId, code])
  @@index([companyId, isActive])
}

// docs/visit_masters.md §3.2 — spec-sfa.md §25 Visit Frequency. Belum ada
// konsumen di v1 (§0.10).
model visitFrequency {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    Int
  code         String    @db.VarChar(32) // DAILY, WEEKLY, BIWEEKLY, MONTHLY
  name         String    @db.VarChar(120)
  description  String?   @db.VarChar(255)
  // §0.11 — jarak antar-kunjungan dalam hari. MONTHLY = 30 adalah PERKIRAAN;
  // konsumen yang butuh bulan kalender wajib memakai `code`, bukan angka ini.
  // CHECK "visitFrequency_interval_positive_chk" (1..366) manual (§3.5).
  intervalDays Int
  sortOrder    Int       @default(0)
  isActive     Boolean   @default(true)

  createdById  Int
  createdAt    DateTime  @default(dbgenerated("NOW()"))
  updatedAt    DateTime? @default(dbgenerated("NOW()"))

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users   @relation("VisitFrequencyCreatedBy", fields: [createdById], references: [id])

  @@unique([companyId, code])
  @@index([companyId, isActive])
}

model storeVisitPhoto {
  id          Int                 @id @default(autoincrement())
  uuid        String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  visitId     Int
  kind        StoreVisitPhotoKind
  objectKey   String              @db.Text
  sizeBytes   Int?
  contentType String              @db.VarChar(32)
  // false selama menunggu client PUT ke bucket; true setelah /confirm & file.exists() lolos
  isConfirmed Boolean             @default(false)
  takenAt     DateTime?
  lat         Float?
  lng         Float?
  createdAt   DateTime            @default(dbgenerated("NOW()"))

  visit       storeVisit          @relation(fields: [visitId], references: [id], onDelete: Cascade)

  @@index([visitId, kind])
  @@index([isConfirmed, createdAt]) // untuk cron pembersih foto yatim
}

// Counter visitNumber per company. Di-increment atomik lewat
// INSERT ... ON CONFLICT DO UPDATE di dalam transaksi check-in — bukan SELECT MAX()+1,
// dan bukan sequence Postgres (yang berarti DDL dari jalur request).
model storeVisitCounter {
  companyId  Int     @id
  lastNumber Int     @default(0)

  company    company @relation(fields: [companyId], references: [id], onDelete: Cascade)
}

enum StoreVisitAuditEvent {
  mockLocationBlocked
  outOfRadius
  overrideUsed
  outOfScope // §0.19 store_visit_grouping.md — check-in ditolak karena toko di luar wilayah caller
}

// Jejak peristiwa check-in yang relevan untuk deteksi kecurangan (§9.8).
//
// Alasan tabel ini ada terpisah dari "storeVisit": dua dari tiga peristiwanya adalah
// PENOLAKAN, dan penolakan tidak menghasilkan baris "storeVisit" sama sekali. Tanpa
// tabel ini, sales yang mencoba check-in 15x dari 800 m setiap hari justru yang paling
// tidak terlihat di dashboard — semua percobaannya gagal, jadi riwayat kunjungannya kosong.
//
// Preseden aturannya sudah ada di §6.11: kunjungan "cancelled" sengaja disimpan sebagai
// baris, bukan di-hard-delete, karena pembatalan berulang di toko yang sama adalah sinyal
// yang perlu dilihat atasan. Percobaan yang ditolak adalah sinyal sejenis.
model storeVisitAuditLog {
  id              Int                  @id @default(autoincrement())
  uuid            String               @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       Int
  storeId         Int
  userId          Int
  // NULL untuk percobaan yang ditolak — tidak ada kunjungan yang terbentuk.
  // Terisi hanya untuk peristiwa pada kunjungan yang benar-benar jadi (overrideUsed).
  visitId         Int?

  event           StoreVisitAuditEvent
  lat             Float
  lng             Float
  accuracyMeters  Float
  distanceMeters  Int
  isMock          Boolean              @default(false)
  // overrideReason untuk overrideUsed; NULL untuk peristiwa lain.
  reason          String?              @db.VarChar(255)
  // Membedakan retry otomatis aplikasi (clientRequestId sama berulang) dari percobaan
  // sengaja yang berbeda-beda — dua pola yang artinya berlawanan saat menilai kecurangan.
  clientRequestId String?              @db.Uuid

  createdAt       DateTime             @default(dbgenerated("NOW()"))

  company         company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  store           store                @relation(fields: [storeId], references: [id])
  // Restrict, sama alasannya dengan storeVisit.user: catatan ini bukti, dan bukti tidak
  // boleh ikut hilang saat user dihapus.
  user            users                @relation(fields: [userId], references: [id], onDelete: Restrict)
  // SetNull, BUKAN Cascade: audit yang ikut terhapus bersama objek yang diauditnya bukan
  // audit. Barisnya tetap hidup dengan storeId/userId/koordinatnya utuh.
  visit           storeVisit?          @relation(fields: [visitId], references: [id], onDelete: SetNull)

  @@index([companyId, createdAt])
  @@index([storeId, createdAt])
  @@index([userId, createdAt])
  @@index([companyId, event, createdAt])
}

// Riwayat posisi device selama kunjungan toko aktif — enter/exit terhadap radius toko
// (docs/api-mobile-store-visit-event.md). BUKAN storeVisitAuditLog di atas: tabel itu
// jejak percobaan check-in yang ditolak/dicurangi untuk deteksi fraud, ini murni
// informational (§0, §2 dokumen). Dua sumber menulis ke sini: ping manual dari
// POST /v1/mobile/store-visits/event (§3.1) dan bookend otomatis dari checkIn/checkOut
// (§3.2), keduanya lewat StoreVisitEventService supaya jalur insertnya satu.
model storeVisitLocationEvent {
  id        Int      @id @default(autoincrement())
  visitId   Int
  storeId   Int
  userId    Int
  event     String   @db.VarChar(10) // "enter" | "exit"
  lat       Float
  lng       Float
  accuracy  Float
  timestamp DateTime
  createdAt DateTime @default(dbgenerated("NOW()"))
  // "ping" = §3.1 background ping (dihitung ke PlanLimit.AUTO_CHECKINS) | "bookend" = §3.2,
  // efek samping dari checkIn/checkOut yang eksplisit, tidak pernah dibatasi paket.
  // Default "bookend" disengaja: baris lama (sebelum kolom ini ada) dan baris manapun yang
  // lupa mengisinya jatuh ke sisi yang TIDAK dihitung, supaya company yang sudah ada tidak
  // tiba-tiba kehabisan jatah seumur langganan gara-gara riwayat ping lamanya.
  source    String   @default("bookend") @db.VarChar(10)

  // Cascade, BUKAN Restrict seperti storeVisit.user: log ini turunan kunjungan, bukan
  // bukti kerja independen (§2 dokumen).
  visit     storeVisit @relation(fields: [visitId], references: [id], onDelete: Cascade)
  store     store      @relation(fields: [storeId], references: [id])
  user      users      @relation(fields: [userId], references: [id])

  @@index([visitId])
  @@index([userId, timestamp])
}

// ── Store Visit Form Builder ─────────────────────────────────────────────────
//
// Rancangan lengkap: docs/store_visit_form_builder.md.
//
// Aturan yang mengikat SELURUH tabel di bawah (§1.2): kolom rujukan ke luar modul
// — companyId, userId, visitId, storeId, createdById, publishedById,
// lastEditedById, editedById — adalah Int polos TANPA @relation. Tujuannya supaya
// perubahan pada company/users/store/storeVisit tidak menyentuh modul ini sama
// sekali. Konsekuensinya: setiap query WAJIB memfilter companyId sendiri, dan
// Prisma `include` lintas modul tidak tersedia (dua query lalu digabung di service).

enum StoreVisitFormScope {
  all // muncul untuk semua sales di company
  targeted // hanya untuk employee yang terdaftar di storeVisitFormTemplateUser
}

model storeVisitFormTemplate {
  id          Int                 @id @default(autoincrement())
  uuid        String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Tanpa relasi ke company — lihat §1.2. Difilter manual di setiap query.
  companyId   Int
  name        String              @db.VarChar(120)
  description String?             @db.VarChar(500)
  sortOrder   Int                 @default(0)
  scope       StoreVisitFormScope @default(all)
  isActive    Boolean             @default(true)
  createdById Int

  deletedAt   DateTime?
  createdAt   DateTime            @default(dbgenerated("NOW()"))
  updatedAt   DateTime?           @default(dbgenerated("NOW()"))

  versions    storeVisitFormTemplateVersion[]
  assignees   storeVisitFormTemplateUser[]
  assets      storeVisitFormTemplateAsset[]

  // Sengaja TIDAK ada unique pada name: dua form boleh bernama sama, dan unique
  // yang menghormati soft delete akan memaksa partial index manual — DDL yang
  // hilang senyap saat dev DB di-`db push`.
  @@index([companyId, isActive, deletedAt])
}

model storeVisitFormTemplateVersion {
  id            Int                    @id @default(autoincrement())
  uuid          String                 @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId    Int
  version       Int
  schema        Json
  publishedAt   DateTime?
  publishedById Int?
  createdAt     DateTime               @default(dbgenerated("NOW()"))

  // Restrict, BUKAN Cascade (Keputusan §0.16): submission menyimpan templateVersionId
  // tanpa FK, jadi cascade di sini akan menghapus satu-satunya salinan schema yang
  // dipakai merender jawaban lama — jawaban itu jadi tidak bisa dibaca selamanya.
  template      storeVisitFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  // Nomor versi rapat & anti-balapan pada PEMBUATAN draft (§6.4), bukan pada publish.
  @@unique([templateId, version])
  @@index([templateId, publishedAt])
}

// Gambar unggahan admin untuk kop/kaki PDF (`schema.headers` / `schema.footers`,
// blok `image` ber-`source: "upload"`). Milik TEMPLATE, bukan versi: draft baru
// menyalin schema versi sebelumnya, jadi aset yang sama harus tetap sah dirujuk
// lintas versi tanpa diunggah ulang.
model storeVisitFormTemplateAsset {
  id           Int                    @id @default(autoincrement())
  uuid         String                 @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  templateId   Int
  // Tanpa relasi ke company — lihat §1.2. Ikut disimpan supaya objectKey bisa
  // dicek berada di folder company-nya sendiri tanpa join.
  companyId    Int
  objectKey    String                 @db.Text
  // Hanya image/png & image/jpeg (LAYOUT_ASSET_CONTENT_TYPES).
  contentType  String                 @db.VarChar(32)
  sizeBytes    Int?
  // Pola identik dengan storeVisitFormFile: false sampai /confirm membaca balik objeknya.
  isConfirmed  Boolean                @default(false)
  createdById  Int
  createdAt    DateTime               @default(dbgenerated("NOW()"))

  // Restrict, sama dengan version: aset yang dirujuk versi terpublish adalah bagian
  // dari dokumen immutable itu. Template memang tidak pernah dihapus permanen.
  template     storeVisitFormTemplate @relation(fields: [templateId], references: [id], onDelete: Restrict)

  @@index([templateId])
  @@index([isConfirmed, createdAt]) // untuk cron pembersih aset yang tak pernah dikonfirmasi
}

model storeVisitFormTemplateUser {
  id         Int                    @id @default(autoincrement())
  templateId Int
  // Tanpa relasi ke users — lihat §1.2.
  userId     Int
  createdAt  DateTime               @default(dbgenerated("NOW()"))
  // Soft delete (§2.4.1 docs/audit_log.md); alasan dan kewajibannya sama persis dengan
  // `storeGroupUser.deletedAt`. Setiap pembacaan WAJIB menyaring `deletedAt: null` —
  // kalau tidak, form tetap terkirim ke sales yang penugasannya sudah dicabut.
  deletedAt  DateTime?

  // Cascade, berbeda dengan version di atas: baris assignment adalah konfigurasi,
  // bukan bukti. Perbedaan perlakuan ini disengaja (§3.3).
  template   storeVisitFormTemplate @relation(fields: [templateId], references: [id], onDelete: Cascade)

  // `@@unique([templateId, userId])` DICABUT (§2.4.2 docs/audit_log.md) — digantikan
  // partial unique index "formTemplateUser_assignment_unique_active"
  // (WHERE "deletedAt" IS NULL) di migration SQL + prisma/apply-partial-indexes.js.
  @@index([userId])
}

model storeVisitFormSubmission {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  // Semua kolom rujukan di bawah tanpa relasi — lihat §1.2.
  companyId         Int
  visitId           Int
  // Disimpan ikut supaya endpoint mobile (yang bekerja dengan uuid) tidak perlu
  // menyentuh tabel storeVisit hanya untuk menerjemahkan id → uuid, dan supaya
  // baris ini tetap bisa ditelusuri kalau kunjungannya hilang.
  visitUuid         String    @db.Uuid
  userId            Int

  // Denormalisasi (Keputusan §0.18). Tanpa FK, filter/sort/paginasi admin per store
  // atau per tanggal kunjungan tidak bisa dilakukan lewat join. Ditulis sekali saat
  // baris dibuat dan TIDAK pernah diperbarui — laporan menampilkan keadaan saat kunjungan.
  storeId           Int
  storeName         String    @db.VarChar(120)
  visitCheckInAt    DateTime

  templateId        Int
  // templateId DAN templateVersionId dua-duanya disimpan, bukan salah satu:
  //  - unique-nya harus terhadap templateId (identitas stabil), kalau tidak sales
  //    bisa punya dua submission untuk form yang sama hanya karena admin publish
  //    versi baru di tengah kunjungan;
  //  - templateVersionId di-pin saat baris ini pertama dibuat dan tidak pernah
  //    berubah (§6.1), dipakai merender ulang jawaban persis bentuk aslinya.
  //
  // Keduanya TANPA @relation walau menunjuk tabel modul sendiri: template yang
  // dihapus permanen tidak boleh pernah bisa menghapus submission (§3.4).
  templateVersionId Int

  answers           Json      @default("{}")
  // NULL = masih draft. Terisi = final dan tidak bisa diubah lagi oleh sales.
  submittedAt       DateTime?
  // Idempotensi submit (Keputusan §0.21), pola sama dengan storeVisit.clientRequestId.
  // NULL selama masih draft; diisi oleh request submit yang berhasil.
  clientRequestId   String?   @db.Uuid

  // Jejak edit manager (Keputusan §0.26–§0.29). revisionCount naik satu tiap edit dan
  // dipakai sebagai penjaga concurrency optimistik di §6.8 — BUKAN sekadar penghitung.
  // 0 berarti belum pernah diedit siapa pun, jadi angka ini juga jadi penanda cepat
  // "jawaban ini masih apa adanya dari lapangan" di layar list.
  revisionCount     Int       @default(0)
  lastEditedAt      DateTime?
  lastEditedById    Int?

  createdAt         DateTime  @default(dbgenerated("NOW()"))
  updatedAt         DateTime? @default(dbgenerated("NOW()"))

  files             storeVisitFormFile[]
  revisions         storeVisitFormSubmissionRevision[]

  // Satu template maksimal sekali per kunjungan (Keputusan §0.6). Constraint ini
  // sekaligus sumber idempotensi draft: upsert by (visitId, templateId), jadi retry
  // jaringan di lapangan tidak menghasilkan baris ganda.
  @@unique([visitId, templateId])
  // NULL dianggap berbeda satu sama lain di Postgres, jadi draft yang belum submit
  // tidak saling bertabrakan di sini.
  @@unique([userId, clientRequestId])
  @@index([companyId, submittedAt])
  @@index([companyId, storeId, submittedAt])
  @@index([templateId, submittedAt])
  @@index([userId, createdAt])
}

model storeVisitFormFile {
  id           Int                      @id @default(autoincrement())
  uuid         String                   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId Int
  // ADVISORY saja (Keputusan §0.22). Jalur field saat file diunggah, mis.
  // "diserahkan.ttd" atau "unit_list.2.foto". Indeks baris repeater bergeser kalau
  // sales menghapus baris, jadi kolom ini TIDAK dipakai untuk menentukan file yatim —
  // rekonsiliasi memakai fileUuid yang muncul di answers (§6.5). Diisi ulang saat submit.
  fieldPath    String?                  @db.VarChar(200)
  objectKey    String                   @db.Text
  // 128, bukan 32: "application/vnd.openxmlformats-officedocument.spreadsheetml.sheet"
  // saja sudah 65 karakter.
  contentType  String                   @db.VarChar(128)
  sizeBytes    Int?
  // false selama menunggu client PUT ke bucket; true setelah /confirm & file.exists() lolos.
  // Pola identik dengan storeVisitPhoto.
  isConfirmed  Boolean                  @default(false)
  createdAt    DateTime                 @default(dbgenerated("NOW()"))

  submission   storeVisitFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Cascade)

  // Tidak ada @@index pada objectKey — pencariannya selalu lewat submissionId.
  @@index([submissionId])
  @@index([isConfirmed, createdAt]) // untuk cron pembersih file yatim
}

model storeVisitFormSubmissionRevision {
  id            Int                      @id @default(autoincrement())
  uuid          String                   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  submissionId  Int
  // Nomor revisi yang DIHASILKAN edit ini: 1 untuk edit pertama, dst.
  // Sama dengan storeVisitFormSubmission.revisionCount sesudah edit tersebut.
  revision      Int

  // BEFORE-image: isi answers SEBELUM edit ini. Baris terakhir + kolom answers di
  // submission = riwayat lengkap. Menyimpan before-image (bukan after) membuat
  // "kembalikan ke keadaan semula" cuma perlu membaca satu baris.
  answersBefore Json
  // Alasan wajib diisi. Koreksi tanpa alasan tidak bisa dipertanggungjawabkan saat
  // angka yang diedit itu dipersoalkan berbulan-bulan kemudian.
  reason        String                   @db.VarChar(500)

  // Tanpa relasi ke users — lihat §1.2.
  editedById    Int
  createdAt     DateTime                 @default(dbgenerated("NOW()"))

  // Restrict: riwayat revisi adalah bukti, dan submission memang tidak punya jalur
  // penghapusan sama sekali (§6.6).
  submission    storeVisitFormSubmission @relation(fields: [submissionId], references: [id], onDelete: Restrict)

  // Anti-balapan: dua edit paralel yang lolos ke sini tidak bisa menghasilkan dua
  // baris ber-revision sama. Pasangannya di §6.8.
  @@unique([submissionId, revision])
  @@index([submissionId, createdAt])
}

// ── Reviser Submission Form ──────────────────────────────────────────────────
//
// Rancangan lengkap: docs/store_visit_form_revisers.md.

/// Siapa yang boleh mengoreksi submission yang sudah final (docs/store_visit_form_revisers.md §0.4).
enum StoreVisitFormReviseMode {
  allPrivileged // semua yang lolos @Roles — perilaku sebelum fitur ini ada
  selected // hanya user yang terdaftar di storeVisitFormReviser
}

/// Siapa saja yang boleh mengoreksi submission form kunjungan di satu company
/// (docs/store_visit_form_revisers.md §3.3). Berlaku hanya saat
/// `company.storeVisitFormReviseMode = selected`.
///
/// Aturan §1.2 form builder berlaku di sini juga: companyId/userId/createdById adalah
/// Int polos TANPA @relation, jadi setiap query WAJIB memfilter companyId sendiri.
model storeVisitFormReviser {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  userId      Int
  createdById Int

  /// Soft delete, alasannya sama persis dengan storeVisitFormTemplateUser.deletedAt:
  /// pencabutan hak adalah kejadian yang harus tetap terbaca di audit. SETIAP pembacaan
  /// WAJIB menyaring `deletedAt: null` — kalau tidak, hak yang sudah dicabut tetap berlaku.
  deletedAt   DateTime?
  createdAt   DateTime  @default(dbgenerated("NOW()"))

  /// `@@unique([companyId, userId])` TIDAK dipakai: ia menutup pintu bagi baris yang
  /// sudah dicabut untuk ditambahkan kembali. Penggantinya partial unique index manual
  /// "storeVisitFormReviser_unique_active" (WHERE "deletedAt" IS NULL) — §3.4.
  @@index([companyId, deletedAt])
  @@index([userId])
}

// docs/audit_log.md §2.1 — Fase 0.

enum AuditEntityType {
  company
  employee
  store
  storeGroup
  storeVisitForm
  storeVisitPlan
  geofence
  negativeZone
  /// Model `accessLevel` (docs/custom_roles.md §11 F12). Namanya `role`, bukan
  /// `accessLevel`, mengikuti `users` → `employee`: nilai enum ini muncul di
  /// layar admin, dan yang dilihat admin memang "role".
  role
  /// docs/customers.md §0.8 — lima nilai, bukan satu `customerMaster`
  /// ber-`subEntity`: `AuditEntityModelSpec` tidak punya field itu, dan keempat
  /// tabel master tidak punya entitas induk (bukan companion model).
  customer
  customerType
  customerGroup
  customerChannel
  customerSubChannel
  /// docs/product_master.md §13.1 (F1) — sepuluh nilai. `productUom` dan
  /// `productBarcode` sengaja TIDAK dapat nilai sendiri: keduanya bagian dari
  /// produknya dan perubahannya sudah tercatat sebagai perubahan produk lewat
  /// trigger `bump_product_updated_at`. Dua nilai enum untuk itu hanya akan
  /// menghasilkan baris audit yang tidak pernah dibaca siapa pun.
  product
  productCategory
  productSubCategory
  productBrand
  productPrincipal
  uom
  taxRate
  priceList
  priceListItem
  productCustomField
  /// docs/order_design.md §3.1 (F1) — enam nilai. `orderItem` sengaja TIDAK dapat
  /// nilai sendiri: perubahannya sudah tercatat sebagai perubahan order lewat
  /// trigger `bump_order_updated_at` — pola `productUom`/`productBarcode` di atas.
  order
  orderType
  orderReason
  orderPaymentTerm
  orderPaymentMethod
  orderCustomFieldDefinition
  /// docs/visit_masters.md §8.4 (F1) — dua nilai, pola orderPaymentMethod.
  visitType
  visitFrequency
  /// specs/006-employee-divisions R9. `divisionMember` tidak dapat nilai sendiri: perubahannya
  /// tercatat sebagai perubahan division (mode membership).
  division
}

enum AuditAction {
  create
  update
  delete
  restore
}

enum AuditActorType {
  user // ada JWT, ada req.user
  system // cron, queue worker, backfill script
  webhook // paypal/midtrans/jira/clickup — pemicunya di luar
}

model auditLog {
  id              Int             @id @default(autoincrement())
  uuid            String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  // Tanpa @relation ke company/users — §0.5. Difilter manual di setiap query.
  companyId       Int
  entityType      AuditEntityType
  entityId        Int
  entityUuid      String?         @db.Uuid
  // Nama/kode objek SAAT kejadian. Didenormalisasi supaya daftar tetap terbaca
  // setelah barisnya benar-benar hilang, dan supaya "Jogja Barat" pada log bulan
  // lalu tidak ikut berubah saat region itu di-rename hari ini.
  entityLabel     String?         @db.VarChar(160)
  // Tabel pendamping yang perubahannya dicatat atas nama entitas induk (§0.13).
  // NULL = perubahan pada tabel utama entitas itu sendiri.
  subEntity       String?         @db.VarChar(40)

  action          AuditAction
  actorType       AuditActorType  @default(user)
  actorId         Int?
  actorName       String?         @db.VarChar(160)
  actorRole       String?         @db.VarChar(32)

  requestId       String?         @db.Uuid
  route           String?         @db.VarChar(160)
  ipAddress       String?         @db.VarChar(45)
  userAgent       String?         @db.VarChar(255)

  // Sudah tersaring §3.4. create → before NULL; delete → after NULL.
  // Menulis NULL ke kolom Json Prisma memakai `Prisma.DbNull`, BUKAN `null` polos —
  // `null` polos adalah type error, dan di `createMany` ia jebakan yang tidak berbunyi.
  before          Json?
  after           Json?
  changedFields   String[]

  // true hanya pada action=delete yang snapshot-nya lengkap & entitasnya
  // punya jalur restore. Dihitung saat tulis, bukan saat baca (§5.1).
  isRestorable    Boolean         @default(false)
  restoredAt      DateTime?
  restoredById    Int?
  // uuid baris auditLog beraksi `restore` yang memulihkan baris ini.
  restoredByLogId String?         @db.Uuid

  createdAt       DateTime        @default(dbgenerated("NOW()"))

  @@index([companyId, createdAt])
  @@index([companyId, entityType, entityId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@index([companyId, entityType, action, createdAt])
  @@index([companyId, entityType, entityUuid, createdAt])
}

// docs/table_field_visibility.md — F1 (§3).

/// Mode visibilitas satu kolom tabel untuk satu role (docs/table_field_visibility.md §0.5).
enum FieldVisibilityMode {
  visible // nilai dikirim apa adanya
  revealable // nilai null; frontend render •••; bisa dibuka per baris, tercatat (§7)
  masked // nilai null; frontend render •••; tidak ada jalan buka
  hidden // nilai null; kolomnya tidak dirender sama sekali
}

/// Satu baris = satu penyimpangan dari default. Tidak ada baris untuk kolom yang
/// `visible` (§0.13): default hidup di registry (`table-field.registry.ts`), bukan di sini.
model tableFieldVisibility {
  id            Int                 @id @default(autoincrement())
  uuid          String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId     Int
  /// NULL = default se-company (berlaku untuk role yang tidak punya override).
  /// Terisi = override untuk satu role. §1.6 — companyId tetap wajib meski
  /// accessLevel-nya global, supaya setelan satu company tidak bocor ke company lain.
  accessLevelId Int?

  tableKey      String              @db.VarChar(48)
  columnKey     String              @db.VarChar(48)
  mode          FieldVisibilityMode

  updatedById   Int?
  createdAt     DateTime            @default(dbgenerated("NOW()"))
  updatedAt     DateTime?           @default(dbgenerated("NOW()"))

  company       company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  accessLevel   accessLevel?        @relation(fields: [accessLevelId], references: [id], onDelete: Cascade)

  // Keunikan TIDAK dinyatakan sebagai @@unique: accessLevelId nullable, dan di
  // Postgres NULL <> NULL — dua baris default untuk kolom yang sama akan lolos.
  // Penggantinya dua partial unique index manual (§3.4), di migration SQL dan
  // prisma/apply-partial-indexes.js:
  //   tableFieldVisibility_company_default_key (companyId, tableKey, columnKey)
  //     WHERE "accessLevelId" IS NULL
  //   tableFieldVisibility_role_key (companyId, accessLevelId, tableKey, columnKey)
  //     WHERE "accessLevelId" IS NOT NULL
  @@index([companyId, tableKey])
  @@index([accessLevelId])
}

/// Peristiwa baca, bukan perubahan (§0.9) — tabel sendiri, bukan auditLog: volume
/// jauh lebih besar, dan AuditAction tidak punya nilai `reveal` (§1.5).
model fieldRevealLog {
  id          Int      @id @default(autoincrement())
  uuid        String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid

  companyId   Int
  tableKey    String   @db.VarChar(48)
  columnKey   String   @db.VarChar(48)

  recordId    Int
  recordUuid  String?  @db.Uuid
  /// Nama/kode objek SAAT kejadian — didenormalisasi seperti auditLog.entityLabel,
  /// supaya log tetap terbaca setelah barisnya dihapus atau di-rename.
  recordLabel String?  @db.VarChar(160)

  actorId     Int
  actorName   String?  @db.VarChar(160)
  actorRole   String?  @db.VarChar(32)
  reason      String?  @db.VarChar(255) // §0.14 — disiapkan, belum dipakai fase 1

  requestId   String?  @db.Uuid
  ipAddress   String?  @db.VarChar(45)
  userAgent   String?  @db.VarChar(255)
  createdAt   DateTime @default(dbgenerated("NOW()"))

  // Tanpa @relation ke company/users — mengikuti §0.5 docs/audit_log.md: jejak
  // tidak boleh ikut terhapus bersama pelakunya.
  @@index([companyId, createdAt])
  @@index([companyId, actorId, createdAt])
  @@index([companyId, tableKey, columnKey, createdAt])
}

/// Pencacah kuota reveal harian (docs/table_field_visibility.md §7.4, F6).
///
/// TIDAK diturunkan dengan menghitung baris `fieldRevealLog`: "hitung dulu, lalu
/// insert" adalah TOCTOU yang tetap bocor di `READ COMMITTED` — dua request paralel
/// sama-sama membaca 49 dan sama-sama lolos (CLAUDE.md). Tabel ini dipakai lewat
/// SATU pernyataan `updateMany` ber-syarat `count < limit`, jadi yang memutuskan
/// adalah Postgres, bukan urutan kebetulan dua promise.
///
/// Tanpa @relation ke company/users — alasan yang sama dengan `fieldRevealLog`.
/// Retensinya juga utang yang sama (§10.4): tabel ini tumbuh satu baris per
/// (pelaku × kolom × hari) yang benar-benar dipakai.
model fieldRevealQuota {
  id        Int       @id @default(autoincrement())

  companyId Int
  actorId   Int
  tableKey  String    @db.VarChar(48)
  columnKey String    @db.VarChar(48)
  /// `YYYY-MM-DD` di `company.timeZone` — bukan DATE dan bukan UTC. Hari yang
  /// dimaksud user adalah hari di zona company-nya, dan menyimpannya sebagai teks
  /// membuat batas harinya ditentukan satu tempat di kode alih-alih oleh zona waktu
  /// server database.
  day       String    @db.VarChar(10)
  count     Int       @default(0)

  createdAt DateTime  @default(dbgenerated("NOW()"))
  updatedAt DateTime? @default(dbgenerated("NOW()"))

  /// Kunci pencacah. Semua kolomnya NOT NULL, jadi @@unique biasa sudah cukup —
  /// tidak ada jebakan NULL-unique seperti di `tableFieldVisibility` (§3.4).
  @@unique([companyId, actorId, tableKey, columnKey, day])
  @@index([companyId, day])
}

// ─────────────────────────────────────────────────────────────────────────────
// Product Master (sales product) — docs/product_master.md §3, Fase F1.
//
// Tiga belas model, empat enum. Fondasi order taking; order taking sendiri TIDAK
// dikerjakan di sini (§15 dokumen itu).
//
// Empat hal yang mengikat seluruh blok ini dan tidak boleh diputuskan ulang saat
// menyentuh salah satu model:
//
//   §0.4  Uang & konversi memakai `Decimal`, dan API mengembalikannya sebagai
//         STRING. Ini kolom `Decimal` PERTAMA di repo — uang yang sudah ada
//         (`userPayRate.payRate`) bertipe `Float`. `Number` merusak presisi pada
//         nilai rupiah besar, dan `Decimal` Prisma diserialisasi jadi objek.
//   §0.14 Tidak ada hard delete di seluruh domain katalog. Satu-satunya jalur
//         hapus adalah arsip (`isActive`) dan soft delete (`deletedAt`).
//   §0.15 `deletedAt` HANYA di `product`, `priceList`, dan `priceListItem` —
//         tabel yang barisnya benar-benar bisa hilang dari pandangan device.
//         Master kecil diarsip lewat `isActive` dan dikirim penuh setiap sync,
//         jadi tidak ada yang perlu di-tombstone.
//   §0.16 `updatedAt` dijamin TRIGGER DATABASE (`touch_updated_at`), bukan
//         disiplin programmer — repo ini memakai `@updatedAt` nol kali dan
//         mengisinya manual di service. Delta sync yang berpatokan pada kolom
//         yang bisa lupa diisi akan melewatkan baris secara DIAM-DIAM, dan
//         gejalanya harga salah di lapangan, bukan error di log. Trigger-nya ada
//         di prisma/apply-partial-indexes.js + migration SQL-nya.
//
// Empat index unik di sini PARTIAL dan karena itu TIDAK dinyatakan sebagai
// `@@unique`: product.sku, productUom.isBase, priceList.isDefault, dan tier
// priceListItem. `prisma db push` tidak pernah membuatnya dan MENGHAPUSNYA kalau
// sebelumnya ada — jangan menggantinya dengan `@@unique` saat regenerate.
// ─────────────────────────────────────────────────────────────────────────────

enum UomType {
  unit
  weight
  volume
  length
}

/// Cara `factor` diubah jadi `productUom.conversionRate` (base equivalent):
/// `multiply` → factor, `divide` → 1 / factor (dibulatkan 6 desimal).
enum UomOperator {
  multiply
  divide
}

enum CustomFieldEntity {
  /// §0.7 — kolomnya ada sejak awal walau v1 hanya mengisi `product`. Menambah
  /// `customer`/`store` nanti jadi penambahan nilai enum, bukan perubahan arti
  /// kunci yang sudah tersimpan.
  product
}

enum CustomFieldType {
  text
  number
  date
  boolean
  select
  multiselect
}

enum ProductImportStatus {
  queued
  running
  completed
  failed
}

model productCategory {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  createdById Int
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime? @default(dbgenerated("NOW()"))

  company       company              @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy     users                @relation("ProductCategoryCreatedBy", fields: [createdById], references: [id])
  subCategories productSubCategory[]
  products      product[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  /// Kunci delta sync (§10.4). Master kecil dikirim penuh, tapi keyset-nya tetap
  /// (updatedAt, id) supaya bentuk cursor-nya seragam dengan produk.
  @@index([companyId, updatedAt, id])
}

model productSubCategory {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  categoryId  Int
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  createdById Int
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime? @default(dbgenerated("NOW()"))

  company   company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users           @relation("ProductSubCategoryCreatedBy", fields: [createdById], references: [id])
  category  productCategory @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  products  product[]

  /// `code` unik per COMPANY, bukan per kategori (§3.1) — persis alasan
  /// `customerSubChannel`: kode yang sama di dua kategori membuat dropdown dan
  /// import by-code ambigu, dan import by-code adalah jalur utama modul ini.
  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, categoryId, isActive])
  @@index([companyId, updatedAt, id])
}

model productBrand {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(120)
  description String?   @db.VarChar(255)
  sortOrder   Int       @default(0)
  isActive    Boolean   @default(true)

  createdById Int
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime? @default(dbgenerated("NOW()"))

  company   company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users     @relation("ProductBrandCreatedBy", fields: [createdById], references: [id])
  products  product[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, updatedAt, id])
}

model productPrincipal {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     Int
  code          String    @db.VarChar(32)
  name          String    @db.VarChar(200)
  /// Data orang. Keempatnya TIDAK ikut ke mobile (§10.3) dan tidak masuk
  /// table-field.registry.ts di v1 (§12).
  contactPerson String?   @db.VarChar(150)
  phone         String?   @db.VarChar(50)
  email         String?   @db.VarChar(150)
  address       String?   @db.Text
  isActive      Boolean   @default(true)

  createdById   Int
  createdAt     DateTime  @default(dbgenerated("NOW()"))
  updatedAt     DateTime? @default(dbgenerated("NOW()"))

  company   company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users     @relation("ProductPrincipalCreatedBy", fields: [createdById], references: [id])
  products  product[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, updatedAt, id])
}

/// Tanpa prefix domain (§0.2): tidak ada kandidat tabrakan, dan ia dipakai di
/// banyak konteks. Tujuh UOM bawaan disemai saat REGISTRASI company (§3.3,
/// perbaikan §18.A5) — bukan saat company pertama membuka modul produk, karena
/// itu berarti sebuah `GET` diam-diam menulis.
model uom {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(120)
  uomType     UomType   @default(unit)
  /// NILAI AWAL saat UOM ini ditambahkan ke sebuah produk — disalin ke
  /// `productUom.operator`/`factor`, bukan dibaca ulang. Mengubahnya tidak
  /// menyentuh produk yang sudah ada. `defaultFactor` > 0 (CHECK).
  defaultOperator UomOperator @default(multiply)
  defaultFactor   Decimal     @default(1) @db.Decimal(18, 6)
  isActive    Boolean   @default(true)

  createdById Int
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime? @default(dbgenerated("NOW()"))

  company        company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy      users           @relation("UomCreatedBy", fields: [createdById], references: [id])
  baseOfProducts product[]       @relation("ProductBaseUom")
  productUoms    productUom[]
  priceListItems priceListItem[]
  // docs/order_design.md §3.6 (F1).
  orderItems     orderItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, updatedAt, id])
}

/// `rate` adalah PERSEN (`11.0000` = 11%), bukan pecahan. `isInclusive = true`
/// berarti harga di price list SUDAH mengandung pajak — dasar pengenaan =
/// `price / (1 + rate/100)`; `false` berarti pajak ditambahkan di atas harga.
/// Artinya dikunci di sini supaya modul order taking tidak menafsirnya ulang;
/// perhitungan pajaknya sendiri tidak dikerjakan di rencana ini (§3.4, §15).
model taxRate {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String    @db.VarChar(32)
  name        String    @db.VarChar(120)
  rate        Decimal   @db.Decimal(8, 4)
  isInclusive Boolean   @default(false)
  isActive    Boolean   @default(true)

  createdById Int
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime? @default(dbgenerated("NOW()"))

  company   company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users     @relation("TaxRateCreatedBy", fields: [createdById], references: [id])
  products  product[]
  // docs/order_design.md §3.6 (F1).
  orderItems orderItem[]

  @@unique([companyId, code])
  @@index([companyId, isActive])
  @@index([companyId, updatedAt, id])
}

/// Definisi custom field adalah BARIS TABEL, bukan satu dokumen JSON schema per
/// company (§0.6). Validator form builder (`form-schema.validator.ts`) sengaja
/// TIDAK dipakai ulang: ia mengurus section/group/repeater/file/`visibleIf` —
/// seluruhnya tidak berlaku di dalam satu kolom produk.
model productCustomField {
  id          Int               @id @default(autoincrement())
  uuid        String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  entity      CustomFieldEntity @default(product)
  /// IMMUTABLE (§0.8) — menggantinya = migrasi seluruh `jsonb` di tabel produk.
  /// Bentuknya `^[a-z][a-z0-9_]{0,39}$`, divalidasi di F3. TIDAK PERNAH dipakai
  /// membangun SQL lewat penggabungan string: ia selalu masuk sebagai PARAMETER
  /// (CLAUDE.md), karena isinya ditentukan admin.
  key         String            @db.VarChar(40)
  label       String            @db.VarChar(120)
  /// IMMUTABLE (§0.8) — menggantinya = data lama yang tidak cocok dengan tipenya
  /// sendiri.
  type        CustomFieldType
  /// Hanya untuk select/multiselect: [{ "value": "...", "label": "..." }].
  /// Boleh diubah, tapi hanya MENAMBAH (§0.8).
  options     Json?
  isRequired  Boolean           @default(false)
  /// §0.11 — efeknya SEMPIT dan jelas: field bertanda ini tidak pernah ikut ke
  /// mobile/offline dan tidak ikut export. Ia BUKAN masking per-role:
  /// `table-field.registry.ts` bekerja dengan kunci kolom statis dan tidak bisa
  /// menyensor kunci dinamis (§12.3).
  isSensitive Boolean           @default(false)
  sortOrder   Int               @default(0)
  /// Menghapus definisi = mengarsipkan (§0.9). Nilai di dalam
  /// `product.customFields` TIDAK PERNAH dihapus otomatis — admin salah klik
  /// tidak boleh menghapus data ribuan produk tanpa bisa dibatalkan.
  isActive    Boolean           @default(true)

  createdById Int
  createdAt   DateTime          @default(dbgenerated("NOW()"))
  updatedAt   DateTime?         @default(dbgenerated("NOW()"))

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users   @relation("ProductCustomFieldCreatedBy", fields: [createdById], references: [id])

  @@unique([companyId, entity, key])
  @@index([companyId, entity, isActive])
}

model product {
  id            Int       @id @default(autoincrement())
  uuid          String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId     Int
  sku           String    @db.VarChar(100)
  name          String    @db.VarChar(200)
  description   String?   @db.Text

  categoryId    Int
  subCategoryId Int?
  brandId       Int?
  principalId   Int?
  baseUomId     Int
  taxRateId     Int?

  weight        Decimal?  @db.Decimal(18, 4)
  volume        Decimal?  @db.Decimal(18, 4)

  /// Objek PUBLIK di GCS (§0.22), bukan signed URL: signed read URL GCS maksimal
  /// 7 hari, dan dipakai di katalog offline ia membuat gambar di device mati
  /// sendiri. `imageObjectKey` tidak pernah keluar dari server.
  imageUrl       String?   @db.Text
  imageObjectKey String?   @db.Text
  imageUpdatedAt DateTime?

  isOrderable   Boolean   @default(true)
  isActive      Boolean   @default(true)

  /// §0.5 — FLAT: tidak ada objek bersarang, tidak ada array of object. Nilai yang
  /// sah: string, number, boolean, dan array of string (multiselect). Tanggal
  /// disimpan sebagai string `YYYY-MM-DD`. Key yang tidak terdaftar DITOLAK saat
  /// tulis (422, §0.10), bukan disimpan diam-diam.
  customFields  Json      @default("{}")

  createdById   Int
  deletedAt     DateTime?
  createdAt     DateTime  @default(dbgenerated("NOW()"))
  updatedAt     DateTime? @default(dbgenerated("NOW()"))

  company     company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy   users               @relation("ProductCreatedBy", fields: [createdById], references: [id])
  category    productCategory     @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  subCategory productSubCategory? @relation(fields: [subCategoryId], references: [id], onDelete: Restrict)
  brand       productBrand?       @relation(fields: [brandId], references: [id], onDelete: Restrict)
  principal   productPrincipal?   @relation(fields: [principalId], references: [id], onDelete: Restrict)
  baseUom     uom                 @relation("ProductBaseUom", fields: [baseUomId], references: [id], onDelete: Restrict)
  taxRate     taxRate?            @relation(fields: [taxRateId], references: [id], onDelete: Restrict)

  uoms       productUom[]
  barcodes   productBarcode[]
  priceItems priceListItem[]
  // docs/order_design.md §3.6 (F1) — relasi BALIK murni (tanpa DDL/migration di
  // sisi produk, §0.11): `orderItem.product` di Prisma menuntut pasangan di kedua
  // sisi (`prisma validate` P1012), jadi field ini WAJIB ada walau §19.1 langkah 5
  // menyebut `product` tidak dapat relasi baru — yang dimaksud di sana adalah
  // model produk tidak disentuh DDL-nya, dan field virtual ini memang tidak
  // menghasilkan satu ALTER TABLE pun pada tabel "product".
  orderItems orderItem[]

  // TIDAK memakai @@unique([companyId, sku]) — unique-nya PARTIAL (§3.11), ditulis
  // manual di migration SQL + apply-partial-indexes.js. Jangan hapus saat regenerate.
  @@index([companyId, isActive, deletedAt])
  @@index([companyId, categoryId])
  @@index([companyId, brandId])
  @@index([companyId, principalId])
  /// Kunci delta sync (§10). Keyset pagination memakai (updatedAt, id).
  @@index([companyId, updatedAt, id])
}

/// `product.baseUomId` adalah SUMBER KEBENARAN base UOM; `isBase` di sini
/// divalidasi agar sepakat dengannya (§0.26), dijaga partial unique index (satu
/// `isBase` per produk) dan pemeriksaan di dalam transaksi.
model productUom {
  id             Int       @id @default(autoincrement())
  uuid           String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  productId      Int
  uomId          Int
  /// Relatif terhadap base UOM. BOX = 12 PCS → 12. Harus > 0 (CHECK, §3.11).
  /// = "base equivalent": SELALU hasil `operator` + `factor` di bawah, dihitung
  /// aplikasi (uom-conversion.util.ts). Tetap disimpan karena order, price list,
  /// dan katalog mobile membaca kolom ini langsung.
  conversionRate Decimal   @db.Decimal(18, 6)
  operator       UomOperator @default(multiply)
  /// Angka yang diketik admin. > 0 (CHECK); base UOM selalu multiply × 1.
  factor         Decimal   @default(1) @db.Decimal(18, 6)
  isBase         Boolean   @default(false)
  isSalesUom     Boolean   @default(true)
  isPurchaseUom  Boolean   @default(false)

  createdAt      DateTime  @default(dbgenerated("NOW()"))
  updatedAt      DateTime? @default(dbgenerated("NOW()"))

  // `onDelete: Cascade` di sini AMAN dan disengaja, berbeda dari seluruh FK lain
  // di modul ini: baris `productUom` adalah bagian dari produknya, bukan bukti
  // terpisah. Karena tidak ada hard delete produk (§0.14), cascade-nya praktis
  // tidak pernah berjalan dari aplikasi.
  product product @relation(fields: [productId], references: [id], onDelete: Cascade)
  uom     uom     @relation(fields: [uomId], references: [id], onDelete: Restrict)

  // Tanpa `deletedAt` (§0.15): ia dikirim BERSARANG di baris produknya, jadi
  // `product.updatedAt` yang menjadi tombstone-nya — dinaikkan trigger
  // STATEMENT-level `bump_product_updated_at` (§0.17).
  @@unique([productId, uomId])
  @@index([productId])
}

/// §0.25 — barcode hanya di sini. TIDAK ada kolom `barcode` di `product` maupun
/// `productUom`: barcode di dua tempat membuat keunikan mustahil ditegakkan
/// database. Scan = satu query `WHERE companyId = ? AND barcode = ?`, dan DB yang
/// menjaga. Payload mobile tetap menyajikannya bersarang di produk (§10.3).
model productBarcode {
  id        Int       @id @default(autoincrement())
  uuid      String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId Int
  productId Int
  /// NULL = barcode milik produk (satuan apa pun); terisi = barcode milik satu UOM.
  uomId     Int?
  barcode   String    @db.VarChar(100)

  createdAt DateTime  @default(dbgenerated("NOW()"))
  updatedAt DateTime? @default(dbgenerated("NOW()"))

  company company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  product product @relation(fields: [productId], references: [id], onDelete: Cascade)

  // Unique per company ditulis sebagai `@@unique` biasa karena tabel ini tidak
  // punya `deletedAt` — tidak ada baris terhapus yang perlu dikecualikan.
  @@unique([companyId, barcode])
  @@index([productId])
}

model priceList {
  id           Int       @id @default(autoincrement())
  uuid         String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    Int
  code         String    @db.VarChar(32)
  name         String    @db.VarChar(150)
  /// §0.28 — satu price list = satu currency, default dari `company.currency`.
  currencyCode String    @db.VarChar(10)
  /// DATE polos. "Aktif hari ini" dihitung menurut `company.timeZone` (§18.B3),
  /// bukan UTC: promo "mulai 1 Maret" yang dimaksud admin adalah 1 Maret di
  /// kantornya, dan selisih satu hari berarti harga hidup/mati 7 jam lebih awal
  /// untuk company GMT+7.
  startDate    DateTime? @db.Date
  endDate      DateTime? @db.Date
  /// Fallback company (§0.27). Partial unique: satu default per company.
  isDefault    Boolean   @default(false)
  isActive     Boolean   @default(true)

  createdById  Int
  deletedAt    DateTime?
  createdAt    DateTime  @default(dbgenerated("NOW()"))
  updatedAt    DateTime? @default(dbgenerated("NOW()"))

  company   company         @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users           @relation("PriceListCreatedBy", fields: [createdById], references: [id])
  items     priceListItem[]
  customers customer[]
  // docs/order_design.md §3.5 (F1).
  orders    order[]

  // TIDAK memakai @@unique([companyId, code]) maupun @@unique untuk isDefault —
  // keduanya PARTIAL (§3.11), ditulis manual. Jangan hapus saat regenerate.
  @@index([companyId, isActive, deletedAt])
  @@index([companyId, updatedAt, id])
}

model priceListItem {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalisasi: dipakai delta sync per company tanpa join ke priceList.
  companyId   Int
  priceListId Int
  productId   Int
  uomId       Int
  minQty      Decimal   @default(1) @db.Decimal(18, 4)
  /// NULL = tak terbatas.
  maxQty      Decimal?  @db.Decimal(18, 4)
  price       Decimal   @db.Decimal(18, 2)

  deletedAt   DateTime?
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime? @default(dbgenerated("NOW()"))

  company   company   @relation(fields: [companyId], references: [id], onDelete: Cascade)
  priceList priceList @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  product   product   @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom       uom       @relation(fields: [uomId], references: [id], onDelete: Restrict)
  // docs/order_design.md §3.6 (F1).
  orderItems orderItem[]

  // Unique-nya PARTIAL (§3.11) — tier yang sudah dihapus tidak boleh mengunci
  // tier baru dengan minQty yang sama.
  @@index([priceListId, productId])
  @@index([companyId, updatedAt, id])
}

/// Import Excel berjalan sebagai JOB Bull, bukan di dalam request (§0.23).
/// Dua hal yang mengikat dan mudah terlewat:
///   §18.C3 File-nya WAJIB di GCS (`objectKey`), bukan disk lokal atau memori —
///          job diambil instance mana pun yang terhubung ke Redis yang sama.
///   §9.2   Status yang dipercaya adalah BARIS INI, bukan state Bull: Bull di
///          repo ini dikonfigurasi menghapus job selesai maupun gagal.
/// `createdById` sengaja tanpa relasi ke `users` — satu-satunya FK modul ini yang
/// begitu (§3 pembuka).
model productImportJob {
  id          Int                 @id @default(autoincrement())
  uuid        String              @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  createdById Int
  fileName    String              @db.VarChar(255)
  objectKey   String              @db.Text
  dryRun      Boolean             @default(false)
  status      ProductImportStatus @default(queued)
  totalRows   Int                 @default(0)
  processed   Int                 @default(0)
  succeeded   Int                 @default(0)
  failed      Int                 @default(0)
  /// [{ row, column, code, message }] — dipotong di 500 entri pertama.
  errors      Json                @default("[]")
  warnings    Json                @default("[]")
  startedAt   DateTime?
  finishedAt  DateTime?
  createdAt   DateTime            @default(dbgenerated("NOW()"))
  updatedAt   DateTime?           @default(dbgenerated("NOW()"))

  company company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@index([companyId, createdAt])
}

// ═════════════════════════════════════════════════════════════════════════════
// Order — docs/order_design.md (F1). CRM-shaped: header order menunjuk akun
// (`customer`, §0.9 jangkar wajib), `store`/`storeVisit` opsional (konteks
// lapangan). Tidak ada satu kolom pun bernama "sales" (§0.1). Tidak ada hard
// delete dan tidak ada `deletedAt` di `order` (§0.6) — satu-satunya jalur
// "menghilangkan" order adalah cancel (§6).
// ═════════════════════════════════════════════════════════════════════════════

enum OrderStatus {
  draft
  pending_approval
  approved
  rejected
  cancelled
  /// specs/003 — terminal; hanya dari `approved` lewat pencatatan delivery.
  delivered
}

enum OrderSource {
  web
  mobile
}

/// spec-sfa.md §38 — reason generik. `delivery_adjustment` (specs/003 R11) =
/// alasan baris dikirim kurang dari yang dipesan.
enum OrderReasonType {
  no_order
  order_cancel
  delivery_adjustment
}

/// specs/003 — jenis baris `orderDelivery`: satu `initial` per order (partial
/// unique index manual), nol atau lebih `correction`.
enum OrderDeliveryKind {
  initial
  correction
}

/// Diskriminator `orderCustomFieldDefinition` (§0.11, §3.2) — enum TERPISAH dari
/// `CustomFieldEntity` milik produk, karena tabelnya juga terpisah.
enum OrderCustomFieldEntity {
  order
  orderItem
}

/// Definisi custom field order/orderItem (§0.11). Tabel BARU, TERPISAH dari
/// productCustomField milik modul produk — modul produk tidak disentuh.
model orderCustomFieldDefinition {
  id          Int                    @id @default(autoincrement())
  uuid        String                 @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  entity      OrderCustomFieldEntity
  /// IMMUTABLE (product_master.md §0.8, diwarisi §0.13). `^[a-z][a-z0-9_]{0,39}$`.
  /// TIDAK PERNAH digabung ke string SQL — selalu PARAMETER (CLAUDE.md).
  key         String                 @db.VarChar(40)
  label       String                 @db.VarChar(120)
  /// IMMUTABLE (product_master.md §0.8).
  type        CustomFieldType
  options     Json?
  isRequired  Boolean                @default(false)
  /// §0.13 — tidak ikut mobile/offline, tidak ikut export. Bukan masking per-role.
  isSensitive Boolean                @default(false)
  sortOrder   Int                    @default(0)
  /// Menghapus = mengarsipkan (product_master.md §0.9). Nilai di
  /// order.customFields/orderItem.customFields TIDAK PERNAH dihapus otomatis.
  isActive    Boolean                @default(true)

  createdById Int
  createdAt   DateTime               @default(dbgenerated("NOW()"))
  updatedAt   DateTime?              @default(dbgenerated("NOW()"))

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users   @relation("OrderCustomFieldDefinitionCreatedBy", fields: [createdById], references: [id])

  @@unique([companyId, entity, key])
  @@index([companyId, entity, isActive])
}

model orderType {
  id               Int       @id @default(autoincrement())
  uuid             String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        Int
  code             String    @db.VarChar(32)   // REGULAR, PRE_ORDER, SAMPLE, …
  name             String    @db.VarChar(120)
  /// §0.20 — order bertipe ini masuk `pending_approval` saat submit.
  requiresApproval Boolean   @default(false)
  allowDiscount    Boolean   @default(true)
  allowFreeItem    Boolean   @default(false)
  /// §0.18 — prefix nomor dokumen per tipe. 'ORD', 'PO', 'RPL', …
  numberPrefix     String    @default("ORD") @db.VarChar(8)
  isDefault        Boolean   @default(false)
  isActive         Boolean   @default(true)

  createdById      Int
  createdAt        DateTime  @default(dbgenerated("NOW()"))
  updatedAt        DateTime? @default(dbgenerated("NOW()"))

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users   @relation("OrderTypeCreatedBy", fields: [createdById], references: [id])
  orders    order[]

  // `AffectStock` (spec-sfa.md §29) sengaja tidak ada (§0.23).
  // unique (companyId, code) + "satu isDefault per company" = partial index manual (§3.10).
  @@index([companyId, isActive])
}

model orderReason {
  id          Int             @id @default(autoincrement())
  uuid        String          @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  reasonType  OrderReasonType
  code        String          @db.VarChar(32)   // OUTLET_CLOSED, PRICE_TOO_HIGH, …
  name        String          @db.VarChar(150)
  sortOrder   Int             @default(0)
  isActive    Boolean         @default(true)

  createdById Int
  createdAt   DateTime        @default(dbgenerated("NOW()"))
  updatedAt   DateTime?       @default(dbgenerated("NOW()"))

  company   company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users               @relation("OrderReasonCreatedBy", fields: [createdById], references: [id])
  noOrders  storeVisitNoOrder[]
  cancelled order[]             @relation("OrderCancelReason")
  deliveryItems orderItem[]     @relation("OrderItemDeliveryReason")
  deliveryLines orderDeliveryLine[]

  @@index([companyId, reasonType, isActive])
}

model order {
  id              Int         @id @default(autoincrement())
  uuid            String      @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId       Int
  /// <prefix>-YYYYMM-00001 (§7). Unique per company (partial index manual).
  orderNumber     String      @db.VarChar(32)
  /// Idempotensi tulis dari device (§10.2). UUID v4 dari client.
  clientRequestId String      @db.Uuid

  orderTypeId     Int
  /// §0.9 — JANGKAR. Wajib: order tanpa akun tidak punya tempat menggantungkan
  /// price list, termin, maupun tagihan.
  customerId      Int
  /// Outlet / tempat kirim. NULL sah (order kantor, telesales).
  storeId         Int?
  /// Kunjungan yang menaungi order. NULL sah (order di luar kunjungan).
  storeVisitId    Int?
  /// Snapshot region toko saat order dibuat — pola storeVisit.storeGroupId
  /// (§2.4 store_visit_grouping.md). Tidak pernah ditulis ulang. NULL kalau
  /// order tanpa toko.
  storeGroupId    Int?
  /// §0.10 — pemilik order (yang diperhitungkan), BUKAN pengetik.
  ownerId         Int

  status          OrderStatus @default(draft)
  source          OrderSource @default(mobile)

  /// DATE polos, diturunkan menurut `company.timeZone` (§5.6). BUKAN timestamp UTC.
  orderDate       DateTime    @db.Date
  requestedDeliveryDate DateTime? @db.Date
  note            String?     @db.Text

  /// Snapshot (§0.5).
  currencyCode    String      @db.VarChar(10)
  priceListId     Int?

  /// §0.21 — termin & metode bayar.
  orderPaymentTermId   Int?
  /// Snapshot jumlah hari termin saat order dibuat.
  paymentTermDays Int?
  /// orderDate + paymentTermDays, dihitung menurut company.timeZone (§5.7).
  dueDate         DateTime?   @db.Date
  orderPaymentMethodId Int?
  /// Nomor giro/cek/transfer — wajib kalau paymentMethod.requiresReference.
  paymentReference String?    @db.VarChar(64)

  /// Hasil hitung SERVER (§0.19, §5).
  subtotal        Decimal     @default(0) @db.Decimal(18, 2)
  discountTotal   Decimal     @default(0) @db.Decimal(18, 2)
  taxTotal        Decimal     @default(0) @db.Decimal(18, 2)
  grandTotal      Decimal     @default(0) @db.Decimal(18, 2)
  itemCount       Int         @default(0)

  submittedAt     DateTime?
  /// Yang menekan Submit — belum tentu owner (admin bisa men-submit order sales).
  /// NULL untuk baris sebelum kolom ini ada; sengaja tidak di-backfill dari ownerId.
  submittedById   Int?
  approvedAt      DateTime?
  approvedById    Int?
  rejectedAt      DateTime?
  rejectedById    Int?
  rejectNote      String?     @db.VarChar(255)
  cancelledAt     DateTime?
  cancelledById   Int?
  cancelReasonId  Int?
  cancelNote      String?     @db.VarChar(255)

  /// specs/003 — delivery. Semua NULL sampai `delivered` (FR-013: "belum
  /// dikirim", bukan 0). Total asli di atas TIDAK PERNAH ditulis delivery (FR-006).
  /// Waktu kirim aktual yang diisi user (R12); berubah hanya lewat koreksi.
  deliveredAt        DateTime?
  /// Waktu server saat delivery AWAL dicatat. Tidak pernah ditulis ulang.
  deliveryRecordedAt DateTime?
  deliveredById      Int?
  /// 0 = belum pernah dikirim; 1 setelah delivery; +1 per koreksi. Token
  /// optimistic lock koreksi (R5 T3).
  deliveryRevision   Int         @default(0)
  finalSubtotal      Decimal?    @db.Decimal(18, 2)
  finalDiscountTotal Decimal?    @db.Decimal(18, 2)
  finalTaxTotal      Decimal?    @db.Decimal(18, 2)
  finalGrandTotal    Decimal?    @db.Decimal(18, 2)

  /// §0.12 — flat, key terdaftar saja (entity = order).
  customFields    Json        @default("{}")

  createdById     Int
  createdAt       DateTime    @default(dbgenerated("NOW()"))
  updatedAt       DateTime?   @default(dbgenerated("NOW()"))

  company       company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  orderType     orderType      @relation(fields: [orderTypeId], references: [id], onDelete: Restrict)
  customer      customer       @relation(fields: [customerId], references: [id], onDelete: Restrict)
  store         store?         @relation(fields: [storeId], references: [id], onDelete: Restrict)
  storeVisit    storeVisit?    @relation(fields: [storeVisitId], references: [id], onDelete: Restrict)
  storeGroup    storeGroup?    @relation(fields: [storeGroupId], references: [id], onDelete: Restrict)
  priceList     priceList?     @relation(fields: [priceListId], references: [id], onDelete: Restrict)
  orderPaymentTerm   orderPaymentTerm?   @relation(fields: [orderPaymentTermId], references: [id], onDelete: Restrict)
  orderPaymentMethod orderPaymentMethod? @relation(fields: [orderPaymentMethodId], references: [id], onDelete: Restrict)
  owner         users          @relation("OrderOwner", fields: [ownerId], references: [id], onDelete: Restrict)
  createdBy     users          @relation("OrderCreatedBy", fields: [createdById], references: [id])
  submittedBy   users?         @relation("OrderSubmittedBy", fields: [submittedById], references: [id], onDelete: Restrict)
  approvedBy    users?         @relation("OrderApprovedBy", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy    users?         @relation("OrderRejectedBy", fields: [rejectedById], references: [id], onDelete: Restrict)
  cancelledBy   users?         @relation("OrderCancelledBy", fields: [cancelledById], references: [id], onDelete: Restrict)
  cancelReason  orderReason?   @relation("OrderCancelReason", fields: [cancelReasonId], references: [id], onDelete: Restrict)
  deliveredBy   users?         @relation("OrderDeliveredBy", fields: [deliveredById], references: [id], onDelete: Restrict)
  items         orderItem[]
  deliveries    orderDelivery[]

  // TIDAK ada deletedAt (§0.6).
  @@index([companyId, status, orderDate])
  @@index([companyId, orderDate, id])
  @@index([companyId, customerId, orderDate])
  @@index([companyId, storeId, orderDate])
  @@index([companyId, ownerId, orderDate])
  @@index([companyId, storeGroupId, orderDate])
  @@index([companyId, storeVisitId])
  @@index([companyId, dueDate])
  /// Keyset delta (§10.3).
  @@index([companyId, updatedAt, id])
}

model orderItem {
  id              Int      @id @default(autoincrement())
  uuid            String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  /// Denormalisasi — laporan per company tanpa join ke header (pola priceListItem).
  companyId       Int
  orderId         Int
  lineNo          Int

  productId       Int
  uomId           Int

  /// SNAPSHOT (§0.5) — tidak pernah dibaca ulang dari master.
  productSku      String   @db.VarChar(100)
  productName     String   @db.VarChar(200)
  uomCode         String   @db.VarChar(32)
  /// SNAPSHOT dari productUom.operator/factor — conversionRate adalah hasilnya
  /// (base equivalent), disimpan terpisah supaya "1 BOX = 24 PCS" tetap terbaca
  /// walaupun konversi produknya diubah kemudian.
  operator        UomOperator @default(multiply)
  factor          Decimal  @default(1) @db.Decimal(18, 6)
  conversionRate  Decimal  @db.Decimal(18, 6)
  priceListItemId Int?
  /// Harga daftar sebelum diskon/free goods — untuk laporan selisih.
  listUnitPrice   Decimal? @db.Decimal(18, 2)
  unitPrice       Decimal  @db.Decimal(18, 2)

  qty             Decimal  @db.Decimal(18, 4)
  /// qty * conversionRate — supaya laporan lintas UOM tidak menghitung ulang.
  qtyInBaseUom    Decimal  @db.Decimal(18, 4)

  discountPercent Decimal  @default(0) @db.Decimal(5, 2)
  discountAmount  Decimal  @default(0) @db.Decimal(18, 2)
  /// §0.22 — menampung HASIL promo (manual di v1). unitPrice = 0, dan item ini
  /// tidak ikut penyebut batas diskon (§5.4).
  isFreeGood      Boolean  @default(false)

  taxRateId       Int?
  taxRate         Decimal  @default(0) @db.Decimal(8, 4)
  taxIsInclusive  Boolean  @default(false)

  /// Hasil hitung server (§5.2).
  grossAmount     Decimal  @db.Decimal(18, 2)
  discountValue   Decimal  @db.Decimal(18, 2)
  netAmount       Decimal  @db.Decimal(18, 2)
  taxAmount       Decimal  @db.Decimal(18, 2)
  lineTotal       Decimal  @db.Decimal(18, 2)

  /// specs/003 — delivery. NULL sampai order `delivered`. qty & jumlah asli di
  /// atas tidak pernah ditulis delivery (FR-006). CHECK manual: 0 ≤ deliveredQty ≤ qty.
  deliveredQty          Decimal? @db.Decimal(18, 4)
  deliveredQtyInBaseUom Decimal? @db.Decimal(18, 4)
  finalGrossAmount      Decimal? @db.Decimal(18, 2)
  /// Termasuk diskon nominal yang diskalakan proporsional (R3).
  finalDiscountValue    Decimal? @db.Decimal(18, 2)
  finalNetAmount        Decimal? @db.Decimal(18, 2)
  finalTaxAmount        Decimal? @db.Decimal(18, 2)
  finalLineTotal        Decimal? @db.Decimal(18, 2)
  /// Diisi iff deliveredQty < qty (aturan service, FR-005 — bukan CHECK).
  deliveryReasonId      Int?
  deliveryNote          String?  @db.VarChar(255)

  note            String?  @db.VarChar(255)
  /// §0.12 — entity = orderItem, maksimal 20 key (§0.14).
  customFields    Json     @default("{}")

  createdAt       DateTime  @default(dbgenerated("NOW()"))
  updatedAt       DateTime? @default(dbgenerated("NOW()"))

  company       company        @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order         order          @relation(fields: [orderId], references: [id], onDelete: Cascade)
  product       product        @relation(fields: [productId], references: [id], onDelete: Restrict)
  uom           uom            @relation(fields: [uomId], references: [id], onDelete: Restrict)
  priceListItem priceListItem? @relation(fields: [priceListItemId], references: [id], onDelete: Restrict)
  taxRateRef    taxRate?       @relation(fields: [taxRateId], references: [id], onDelete: Restrict)
  deliveryReason orderReason?  @relation("OrderItemDeliveryReason", fields: [deliveryReasonId], references: [id], onDelete: Restrict)
  deliveryLines orderDeliveryLine[]

  @@unique([orderId, lineNo])
  @@index([orderId])
  @@index([companyId, productId])
}

/// specs/003 R4 — satu baris per AKSI delivery (initial / correction). Append-only:
/// tidak ada jalur update/delete di kode, dan sengaja tanpa `updatedAt`.
/// "Satu initial per order" = partial unique index manual
/// `orderDelivery_one_initial_per_order` (FR-018).
model orderDelivery {
  id                Int               @id @default(autoincrement())
  uuid              String            @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         Int
  orderId           Int
  kind              OrderDeliveryKind
  /// = order.deliveryRevision SETELAH aksi ini (1, 2, …) — urutan history.
  revision          Int
  /// Kanal: koreksi selalu `web`.
  source            OrderSource
  /// Kunci idempotensi delivery awal (R5 T4); NULL untuk koreksi.
  clientRequestId   String?           @db.Uuid
  /// NULL untuk `initial`.
  deliveredAtBefore DateTime?
  deliveredAtAfter  DateTime
  /// initial: grandTotal asli; correction: finalGrandTotal sebelumnya.
  grandTotalBefore  Decimal           @db.Decimal(18, 2)
  grandTotalAfter   Decimal           @db.Decimal(18, 2)
  /// Wajib untuk koreksi (FR-012b), opsional untuk initial.
  note              String?           @db.VarChar(255)
  recordedById      Int
  recordedAt        DateTime          @default(dbgenerated("NOW()"))

  company    company             @relation(fields: [companyId], references: [id], onDelete: Cascade)
  order      order               @relation(fields: [orderId], references: [id], onDelete: Cascade)
  recordedBy users               @relation("OrderDeliveryRecordedBy", fields: [recordedById], references: [id], onDelete: Restrict)
  lines      orderDeliveryLine[]

  @@unique([orderId, revision])
  @@index([companyId, recordedAt])
  @@index([orderId])
}

/// specs/003 R4 — before/after per baris yang BERUBAH dalam satu aksi (FR-011).
/// Reason disimpan sebagai snapshot code/name supaya reason yang diarsipkan atau
/// diganti nama tetap terbaca seperti saat dipakai.
model orderDeliveryLine {
  id              Int      @id @default(autoincrement())
  orderDeliveryId Int
  orderItemId     Int
  lineNo          Int
  orderedQty      Decimal  @db.Decimal(18, 4)
  /// initial: = orderedQty; correction: deliveredQty sebelumnya.
  qtyBefore       Decimal  @db.Decimal(18, 4)
  qtyAfter        Decimal  @db.Decimal(18, 4)
  reasonId        Int?
  reasonCode      String?  @db.VarChar(32)
  reasonName      String?  @db.VarChar(150)
  note            String?  @db.VarChar(255)

  delivery  orderDelivery @relation(fields: [orderDeliveryId], references: [id], onDelete: Cascade)
  orderItem orderItem     @relation(fields: [orderItemId], references: [id], onDelete: Cascade)
  reason    orderReason?  @relation(fields: [reasonId], references: [id], onDelete: Restrict)

  @@unique([orderDeliveryId, orderItemId])
  @@index([orderItemId])
}

/// Baris ini tidak menghalangi order: kunjungan yang ditandai no-order lalu
/// ternyata berorder cukup menghapus barisnya — satu-satunya hard delete di
/// modul ini, dan ia bukan bukti transaksi (§0.17).
model storeVisitNoOrder {
  id           Int      @id @default(autoincrement())
  uuid         String   @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId    Int
  /// Satu kunjungan = paling banyak satu pernyataan "tidak ada order".
  storeVisitId Int      @unique
  storeId       Int
  userId        Int
  orderReasonId Int
  note         String?  @db.VarChar(255)

  createdAt    DateTime  @default(dbgenerated("NOW()"))
  updatedAt    DateTime? @default(dbgenerated("NOW()"))

  company    company     @relation(fields: [companyId], references: [id], onDelete: Cascade)
  storeVisit storeVisit  @relation(fields: [storeVisitId], references: [id], onDelete: Restrict)
  store      store       @relation(fields: [storeId], references: [id], onDelete: Restrict)
  user       users       @relation(fields: [userId], references: [id], onDelete: Restrict)
  orderReason orderReason @relation(fields: [orderReasonId], references: [id], onDelete: Restrict)

  @@index([companyId, createdAt])
  @@index([companyId, orderReasonId])
}

/// Penomoran atomik per company + periode + prefix (§7), pola `storeVisitCounter`
/// (`src/store-visits/store-visits.service.ts:691`).
model orderCounter {
  companyId  Int
  /// 'YYYYMM' — periode reset (§7.2).
  period     String  @db.VarChar(6)
  /// Prefix ikut kunci: deret PO dan ORD tidak saling memakan nomor.
  prefix     String  @db.VarChar(8)
  lastNumber Int     @default(0)

  company    company @relation(fields: [companyId], references: [id], onDelete: Cascade)

  @@id([companyId, period, prefix])
}

model orderPaymentTerm {
  id          Int       @id @default(autoincrement())
  uuid        String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId   Int
  code        String    @db.VarChar(32)   // CASH, NET7, NET30, …
  name        String    @db.VarChar(120)
  /// 0 = tunai/langsung. dueDate = orderDate + dueDays (§5.7).
  dueDays     Int       @default(0)
  isDefault   Boolean   @default(false)
  isActive    Boolean   @default(true)

  createdById Int
  createdAt   DateTime  @default(dbgenerated("NOW()"))
  updatedAt   DateTime? @default(dbgenerated("NOW()"))

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users   @relation("OrderPaymentTermCreatedBy", fields: [createdById], references: [id])
  orders    order[]

  @@index([companyId, isActive])
}

/// Prefix `order` pada kedua master pembayaran (§3.9) menyimpang dari pola
/// pemendekan repo (`store.groupId` → `storeGroup`, dst) — keputusan sadar: nama
/// kolom FK-nya menyebut persis nama tabel yang ditunjuk (§0.24).
model orderPaymentMethod {
  id                Int       @id @default(autoincrement())
  uuid              String    @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId         Int
  code              String    @db.VarChar(32)   // CASH, TRANSFER, GIRO, …
  name              String    @db.VarChar(120)
  /// true → `order.paymentReference` wajib diisi (nomor giro/cek/transfer).
  requiresReference Boolean   @default(false)
  isDefault         Boolean   @default(false)
  isActive          Boolean   @default(true)

  createdById       Int
  createdAt         DateTime  @default(dbgenerated("NOW()"))
  updatedAt         DateTime? @default(dbgenerated("NOW()"))

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users   @relation("OrderPaymentMethodCreatedBy", fields: [createdById], references: [id])
  orders    order[]

  @@index([companyId, isActive])
}

// ─────────────────────────────────────────────────────────────────────────────
// Lembur per PP 35/2021 (specs/004-overtime-pp35/data-model.md)
// ─────────────────────────────────────────────────────────────────────────────

/// specs/004 — status permintaan lembur. Mirror TypeScript manual di
/// `src/overtime/enums/` (SWC + Swagger butuh `type: String`).
enum OvertimeRequestStatus {
  PENDING_APPROVAL
  PENDING_EMPLOYEE
  APPROVED
  REJECTED
  CANCELLED
  COMPLETED
}

/// SELF = diajukan karyawan sendiri, diputuskan approver. ORDER = dibuat approver
/// untuk karyawan, diterima/ditolak karyawan.
enum OvertimeRequestKind {
  SELF
  ORDER
}

enum OvertimeCancelReason {
  BY_REQUESTER
  NO_RESPONSE
  EMPLOYEE_ON_LEAVE
  FEATURE_DISABLED
}

enum OvertimeDayType {
  WORKDAY
  HOLIDAY
}

/// specs/004 — pola hari kerja company, versi append-only. Tanpa baris = default
/// 5 hari kerja, libur Sabtu-Minggu. Resolusi per tanggal: research R2.
/// CHECK manual `companyWorkPattern_shape_chk` (apply-partial-indexes.js).
model companyWorkPattern {
  id           Int       @id @default(autoincrement())
  companyId    Int
  /// 5 atau 6 (CHECK `companyWorkPattern_shape_chk`).
  workDays     Int       @db.SmallInt
  /// Hari ISO 1–7. Tepat 2 untuk pola 5 hari, tepat 1 untuk pola 6 hari (divalidasi di DTO).
  offDays      Int[]
  /// Hari ISO terpendek. Wajib iff 6 hari, dan tidak boleh ada di `offDays`.
  shortDay     Int?
  /// Selalu tanggal awal minggu.
  effectiveFrom DateTime @db.Date
  createdAt    DateTime  @default(now())
  createdById  Int?
  /// Diisi saat digantikan/dibatalkan SEBELUM `effectiveFrom`. Tidak pernah diisi
  /// pada versi yang sudah berlaku.
  supersededAt DateTime?

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  createdBy users?  @relation("CompanyWorkPatternCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@index([companyId, effectiveFrom])
}

/// specs/004 — 1:1 dengan company, dibuat lazy oleh `ensureSettings`. Baris yang
/// tidak ada dibaca sebagai enabled = true, retroWindowDays = 7.
model companyOvertimeSetting {
  id              Int      @id @default(autoincrement())
  companyId       Int      @unique
  enabled         Boolean  @default(true)
  /// 0–31 (divalidasi di DTO).
  retroWindowDays Int      @default(7)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @default(now()) @updatedAt
  updatedById     Int?

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  updatedBy users?  @relation("CompanyOvertimeSettingUpdatedBy", fields: [updatedById], references: [id], onDelete: SetNull)
}

/// specs/004 — approver lembur per company. Himpunan EFEKTIF disaring saat dibaca
/// (research R6): hanya anggota aktif ber-base role SUPER_ADMIN/ADMIN/MANAGER.
model overtimeApprover {
  id          Int      @id @default(autoincrement())
  companyId   Int
  userId      Int
  createdAt   DateTime @default(now())
  /// NULL = owner yang di-seed atau sistem.
  createdById Int?

  company   company @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user      users   @relation("OvertimeApproverUser", fields: [userId], references: [id], onDelete: Cascade)
  createdBy users?  @relation("OvertimeApproverCreatedBy", fields: [createdById], references: [id], onDelete: SetNull)

  @@unique([companyId, userId])
  @@index([companyId])
}

/// specs/004 — satu permintaan lembur untuk satu karyawan pada satu tanggal lokal.
/// "Satu permintaan aktif per hari" = partial unique index manual
/// `overtimeRequest_one_active_per_day` (FR-019). CHECK manual: requested_sec_chk,
/// reject_reason_chk, cancel_reason_chk, overtime_sec_chk (apply-partial-indexes.js).
/// Tidak ada kolom `weekStart`: minggu dihitung dari `date` dan `workweekStartDay`
/// saat ini (research R7).
model overtimeRequest {
  id               Int                   @id @default(autoincrement())
  uuid             String                @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  companyId        Int
  /// Karyawan yang bekerja lembur.
  userId           Int
  /// Karyawan itu sendiri (SELF) atau approver yang memerintah (ORDER).
  requestedById    Int
  kind             OvertimeRequestKind
  /// Tanggal lembur (lokal company).
  date             DateTime              @db.Date
  /// 60…86 400 (CHECK `overtimeRequest_requested_sec_chk`), dari durationMinutes × 60.
  requestedSec     Int
  reason           String                @db.VarChar(500)
  status           OvertimeRequestStatus
  /// Snapshot jendela retro saat dibuat.
  retroWindowDays  Int
  /// SELF: akhir `date + window`. ORDER: akhir `date`.
  responseDeadline DateTime
  /// Akhir `date + window`.
  finalAt          DateTime
  /// Approver (SELF) atau karyawan (ORDER).
  decidedById      Int?
  decidedAt        DateTime?
  /// Wajib iff REJECTED (CHECK `overtimeRequest_reject_reason_chk`).
  rejectReason     String?               @db.VarChar(500)
  /// Wajib iff CANCELLED (CHECK `overtimeRequest_cancel_reason_chk`).
  cancelReason     OvertimeCancelReason?
  cancelledAt      DateTime?
  /// NULL untuk pembatalan oleh sistem.
  cancelledById    Int?
  /// Waktu snapshot.
  approvedAt       DateTime?
  /// Snapshot saat disetujui.
  dayType          OvertimeDayType?
  /// Snapshot: detik normal sebelum pengurangan setengah hari.
  baseNormalSec    Int?
  dailyLimitSec    Int?
  /// Snapshot 5/6, untuk tampilan.
  patternWorkDays  Int?                  @db.SmallInt
  /// Hitungan terakhir: gabungan detik tracking + manual time disetujui pada tanggal itu.
  workedSec        Int?
  /// Hitungan terakhir: setelah pengurangan setengah hari.
  normalSec        Int?
  /// clamp(workedSec − normalSec, 0, requestedSec); CHECK `overtimeRequest_overtime_sec_chk`.
  overtimeSec      Int?
  computedAt       DateTime?
  /// Terisi begitu now ≥ finalAt; tidak pernah dihitung ulang sesudahnya.
  finalizedAt      DateTime?
  /// Diset saat disetujui.
  exceedsDailyLimit  Boolean             @default(false)
  /// Dilabeli ulang per minggu (research R7).
  exceedsWeeklyLimit Boolean             @default(false)
  /// daily OR weekly, untuk filter.
  exceedsLimit     Boolean               @default(false)
  createdAt        DateTime              @default(now())
  updatedAt        DateTime              @default(now()) @updatedAt

  company     company  @relation(fields: [companyId], references: [id], onDelete: Cascade)
  user        users    @relation("OvertimeRequestEmployee", fields: [userId], references: [id], onDelete: Restrict)
  requestedBy users    @relation("OvertimeRequestRequestedBy", fields: [requestedById], references: [id], onDelete: Restrict)
  decidedBy   users?   @relation("OvertimeRequestDecidedBy", fields: [decidedById], references: [id], onDelete: SetNull)
  cancelledBy users?   @relation("OvertimeRequestCancelledBy", fields: [cancelledById], references: [id], onDelete: SetNull)

  @@index([companyId, status, date])
  @@index([companyId, userId, date])
  @@index([companyId, date])
  @@index([requestedById, status])
}
