  RUNNING
  DONE
  FAILED
}

/// specs/007: job operasi berat yang dijalankan operator lewat Bull.
/// Partial unique `adminJob_one_active_per_company` (WHERE status IN ('QUEUED','RUNNING'))
/// hanya ada di migration SQL + prisma/apply-partial-indexes.js.
model adminJob {
  id         Int            @id @default(autoincrement())
  uuid       String         @unique @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  type       AdminJobType
  companyId  Int?
  params     Json
  paramsHash String         @db.VarChar(64)
  dryRun     Boolean
  status     AdminJobStatus @default(QUEUED)
  result     Json?
  log        String?
  operatorId Int
  startedAt  DateTime?      @db.Timestamp(3)
  finishedAt DateTime?      @db.Timestamp(3)
  createdAt  DateTime       @default(now()) @db.Timestamp(3)

  operator   operators      @relation(fields: [operatorId], references: [id], onDelete: Restrict)
  company    company?       @relation(fields: [companyId], references: [id], onDelete: SetNull)

  @@index([companyId, status])
  @@index([type, paramsHash, finishedAt])
}

model holidayLeaveDeduction {
